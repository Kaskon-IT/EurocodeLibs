@using ExportFactory.Extensions;
@using ExportFactory.Services;
@using CommonLibrary

@if(SampleProject != null)
{


    @* Component *@
    <EurocodeGrondslagen @bind-Model="@SampleProject.Grondslagen"
                         ToonGevolgEigenschappen=@ToonReadOnlyFields  />
}


@code {
    [CascadingParameter]
    public SampleProject? SampleProject { get; set; }

    //private string html { get; set; } = "";
    private MigraDoc.DocumentObjectModel.Document document = new();


    private bool ToonReadOnlyFields { get; set; } = !false;


    private void HandelModelChanged(){
        StateHasChanged();
    }


    private MigraDoc.DocumentObjectModel.Document SetDocument(){
        GenerateNewDocument();
        return document;
    }


    private async void GenerateNewDocument(){
        document = new();
        document.AddSection();
        List<Eurocode.Grondslagen.GrondslagenContext> list = [SampleProject.Grondslagen];


        var table = list.ToMigraDocTable(typeof(Eurocode.Grondslagen.GrondslagenContext));
        document.LastSection.AddParagraph("Grondslagen", "TableHeading");
        document.LastSection.Add(table);





        var pivotTable = list.ToMigraDocTable(typeof(Eurocode.Grondslagen.GrondslagenContext), true);
        document.LastSection.AddParagraph("Grondslagen (Pivot-table)", "TableHeading");
        document.LastSection.Add(pivotTable);


        //html = GetHtml();

        await Task.Delay(200);
        StateHasChanged();

    }


