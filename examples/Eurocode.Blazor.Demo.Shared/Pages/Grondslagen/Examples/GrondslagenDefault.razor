@using ExportFactory.Extensions;
@using ExportFactory.Services;

@if(SampleProject != null)
{
    <EurocodeGrondslagen @bind-Model="@SampleProject.Grondslagen" />

    <ExportTableComponent T="@Eurocode.Grondslagen.GrondslagenContext" Item="@SampleProject.Grondslagen"></ExportTableComponent>


    @* <FluentButton OnClick="Export" Title="Export ALL"/>

    @if (!string.IsNullOrEmpty(html))
    {
        <div>@((MarkupString)html)</div>
    } *@

}









@code {
    [CascadingParameter]
    public SampleProject? SampleProject { get; set; }

    private string html { get; set; } = "";

    public void Export(){

        if (SampleProject == null) return;

        // use a List<T> 
        List<Eurocode.Grondslagen.GrondslagenContext> list = [SampleProject.Grondslagen];
        // map to datatable
        var dataTable = list.ToDataTable();
        // map to migradoc.Table
        var migraDocTable = dataTable.ToMigraDocTable(typeof(Eurocode.Grondslagen.GrondslagenContext));
        // create document
        MigraDoc.DocumentObjectModel.Document document = new();
        // add section, add table
        document.AddSection().Add(migraDocTable);

        // HTML
        html = HtmlCreator.GenerateHtmlFromDocument(document, centered: false);


    }

}
