    public string GetHtml(){
        System.Diagnostics.Stopwatch stopwatch = new System.Diagnostics.Stopwatch();
        stopwatch.Start();
        //Console.WriteLine($"Demo document wordt geladen ({DateTime.Now})");
        var content = ExampleDocumentContent.GetExampleDocumentContent(fontFamily, fontSize, pageSetting);
        var document = MigraDocCreator.GenerateDocument(content);
        stopwatch.Stop();
        Console.WriteLine($"Demo geladen ({stopwatch.ElapsedMilliseconds} ms)");
        return (HtmlCreator.GenerateHtmlFromDocument(document));
    }


