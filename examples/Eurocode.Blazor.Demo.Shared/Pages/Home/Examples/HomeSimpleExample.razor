@using ExportFactory.Interfaces.Export
@using ExportFactory.MigraDocContentModels
@using ExportFactory.Services
@using Microsoft.FluentUI.AspNetCore.Components
@using MigraDoc.Rendering

<FluentCard Width="350px" Height="250px">
    <h2>Hello World!</h2>
    <FluentButton Appearance="@Appearance.Accent">Click Me</FluentButton>

    @* Zet hier een voorbeeld voor MigraDoc VOORBLAD *@
    <button @onclick="() => Test()">Test</button>

    <FluentTextField Label="Font-family" @bind-Value="@fontFamily"></FluentTextField>

    <FluentButton OnClick="TestDoc">Maak PDF test</FluentButton>

</FluentCard>

@code{
    [CascadingParameter]
    public SampleProject? SampleProject { get; set; }

    public string fontFamily { get; set; } = "Verdana";
    public int fontSize { get; set; } = 9;

    public void Test(){
        if (SampleProject != null){
            if (SampleProject.DocumentInfo is IExportableCsv csvExporter){
                var watDan = csvExporter.Export(false);
            }
        }

    }

    public void TestDoc(){

        var content = ExampleDocumentContent.GetExampleDocumentContent(fontFamily, fontSize);




        // Generate and save the document
        var document = MigraDocCreator.GenerateDocument(content);

        // Render the document
        var renderer = new PdfDocumentRenderer(true) 
        { 
            Document = document 
        };
        renderer.RenderDocument();
        renderer.PdfDocument.Save("SampleDocument.pdf");


    }


}
