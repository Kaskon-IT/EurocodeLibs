@using ExportFactory.Interfaces.Export
@using ExportFactory.MigraDocContentModels
@using ExportFactory.Services
@using Microsoft.FluentUI.AspNetCore.Components
@using MigraDoc.Rendering

<FluentCard Width="350px" Height="250px">
    <h2>Hello World!</h2>
    <FluentButton Appearance="@Appearance.Accent">Click Me</FluentButton>

    @* Zet hier een voorbeeld voor MigraDoc VOORBLAD *@
    <button @onclick="() => Test()">Test</button>

    <FluentTextField Label="Font-family" @bind-Value="@fontFamily"></FluentTextField>

    <FluentButton OnClick="TestDoc">Maak PDF test</FluentButton>
    <EurocodeRazorClassLibrary.Custom.FluentSelectEnum
    Label="Pagina indeling" 
    TEnum="ExportFactory.MigraDocContentModels.DocumentContent.PageMarginAndPageNumberSettingsEnum" 
    @bind-EnumSelectedValue="pageSetting" />







</FluentCard>

@code{
    [CascadingParameter]
    public SampleProject? SampleProject { get; set; }

    public string fontFamily { get; set; } = "Verdana";
    public int fontSize { get; set; } = 9;
    //public bool mirror

    public ExportFactory.MigraDocContentModels.DocumentContent.PageMarginAndPageNumberSettingsEnum? pageSetting = DocumentContent.PageMarginAndPageNumberSettingsEnum.EvenOnevenGespiegeld;



    public void Test(){
        if (SampleProject != null){
            if (SampleProject.DocumentInfo is IExportableCsv csvExporter){
                var watDan = csvExporter.Export(false);
            }
        }

    }



    public void TestDoc(){

        var content = ExampleDocumentContent.GetExampleDocumentContent(fontFamily, fontSize, pageSetting);

        // Generate and save the document
        var document = MigraDocCreator.GenerateDocument(content);



        // Render the document
        var renderer = new PdfDocumentRenderer(true) 
        { 
            Document = document 
        };
        renderer.RenderDocument();
        renderer.PdfDocument.Save("SampleDocument.pdf");



        //Save the document as RTF
        var migraDocRtf = new MigraDoc.RtfRendering.RtfDocumentRenderer();
        migraDocRtf.Render(document, "SampleDocument.rtf", null);
        var rtfString = migraDocRtf.RenderToString(document, null);
        //var rtfClean = rtfString.Replace(@"\\", @"\");
        var h1 = rtfString.Replace("Heading1", "Kop 1");
        var h2 = h1.Replace("Heading2", "Kop 2");

        
        var test = h2;




    }


}
