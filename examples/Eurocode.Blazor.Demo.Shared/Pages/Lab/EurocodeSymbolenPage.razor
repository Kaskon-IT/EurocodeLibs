@using ExportFactory.Shared
@using Eurocode.Blazor.Demo.Shared.Helpers
@page "/lab/eurocode-symbolen"

<h3>EurocodeSymbolen</h3>

<EurocodeRazorClassLibrary.Shared.EurocodeSymbolen Mappings="eurocodeDictionary"></EurocodeRazorClassLibrary.Shared.EurocodeSymbolen>


<!-- GRID DEMO -->
<FluentDataGrid 
Items="@FilteredItems" 
MultiLine="true" 
AutoFit="true"
HeaderCellAsButtonWithMenu="true"
Style="white-space: pre-wrap;">
    <PropertyColumn Sortable="true" SortBy="sortByKey" Property="x => x.Key" Title="Key" Filtered="!string.IsNullOrEmpty(keyFilter)">
        <ColumnOptions>
            <div class="search-box">
                <FluentSearch Autofocus=true @bind-Value=keyFilter @oninput="HandleKeyFilter" @bind-Value:after="HandleClearFilter" Placeholder="filter..." Style="width: 100%;" Label="Filter" />
            </div>
        </ColumnOptions>
    </PropertyColumn>

    @if (symVisible)
    {
        <PropertyColumn Sortable="true" Property="x => x.Symbool" Title="Symbol" />

    }

    <TemplateColumn Sortable="true" SortBy="@sortBySymbol" Title="Symbol" >
        @{
            var symbolHtml = (context as KeyValueMappingModel)?.SymboolHtml ?? string.Empty;
            var html = (MarkupString)symbolHtml; // Cast naar MarkupString
        }
        <div>@html</div>
    </TemplateColumn>

    <TemplateColumn Sortable="true" SortBy="@sortByDescription" Title="Omschrijving" >
        @{
            var omschrijvingHtml = (context as KeyValueMappingModel)?.OmschrijvingHtml ?? string.Empty;
            var html = (MarkupString)omschrijvingHtml;
        }
        <div>@html</div>
    </TemplateColumn>

    @if (descVisible)
    {
        <PropertyColumn Sortable="true" Property="x => x.Omschrijving" Title="Description" Filtered="!string.IsNullOrEmpty(omschrijvingFilter)">
            <ColumnOptions>
                <div class="search-box">
                    <FluentSearch Autofocus=true @bind-Value=omschrijvingFilter @oninput="HandleOmschrijvingFilter" @bind-Value:after="HandleClearFilter" Placeholder="filter..." Style="width: 100%;" Label="Filter" />
                </div>
            </ColumnOptions>
        </PropertyColumn>
    }


    <PropertyColumn Sortable="true" Property="x => x.Norm" Title="Norm" Filtered="!string.IsNullOrWhiteSpace(normFilter)" >
        <ColumnOptions>
            <div class="search-box">
                <FluentSearch Autofocus=true @bind-Value=normFilter @oninput="HandleNormFilter" @bind-Value:after="HandleClearFilter" Placeholder="filter..." Style="width: 100%;" Label="Filter" />
            </div>
        </ColumnOptions>
    </PropertyColumn>

    <PropertyColumn Sortable="true" Property="x => x.Artikel" Title="Art." Filtered="!string.IsNullOrEmpty(artikelFilter)">
        <ColumnOptions>
            <div class="search-box">
                <FluentSearch Autofocus=true @bind-Value=artikelFilter @oninput="HandleArtikelFilter" @bind-Value:after="HandleClearFilter" Placeholder="filter..." Style="width: 100%;" Label="Filter" />
            </div>
        </ColumnOptions>

    </PropertyColumn>

    <PropertyColumn Sortable="true" SortBy="sortByVergelijking" Property="x => x.Vergelijking" Title="Vgl." Filtered="!string.IsNullOrEmpty(vergelijkingFilter)" >
        <ColumnOptions>
            <div class="search-box">
                <FluentSearch Autofocus=true @bind-Value=vergelijkingFilter @oninput="HandleVergelijkingFilter" @bind-Value:after="HandleClearFilter" Placeholder="filter..." Style="width: 100%;" Label="Filter" />
            </div>
        </ColumnOptions>
    </PropertyColumn>

    <PropertyColumn Sortable="true" Property="x => x.Formaat" Title="Format" >

    </PropertyColumn>

</FluentDataGrid>






@* <p>Keep numbers always sorted ascending inside the group when sorting by group</p>
<FluentDataGrid Items="@_gridData" ResizableColumns=true GridTemplateColumns="0.5fr 0.5fr">

    <PropertyColumn Sortable="true" Property="x => x.Number" Title="Rank" />
    <PropertyColumn Property="x => x.Group" SortBy="groupRankNumberAlwaysAscending" Title="Group" />

</FluentDataGrid> *@








