    IQueryable<KeyValueMappingModel>? FilteredItems
    {
        get
        {
            var result = items;

            if (result is not null && !string.IsNullOrEmpty(keyFilter))
            {
                result = result.Where(c => c.Key.Contains(keyFilter, StringComparison.CurrentCultureIgnoreCase));
            }

            if (result is not null && !string.IsNullOrEmpty(symboolFilter))
            {
                result = result.Where(c => c.Symbool != null && c.Symbool.Contains(symboolFilter, StringComparison.CurrentCultureIgnoreCase));
            }

            if (result is not null && !string.IsNullOrEmpty(omschrijvingFilter))
            {
                result = result.Where(c => c.Omschrijving != null && c.Omschrijving.Contains(omschrijvingFilter, StringComparison.CurrentCultureIgnoreCase));
            }

            if (result is not null && !string.IsNullOrEmpty(normFilter))
            {
                result = result.Where(c => c.Norm != null && c.Norm.Contains(normFilter, StringComparison.CurrentCultureIgnoreCase));
            }

            if (result is not null && !string.IsNullOrEmpty(artikelFilter))
            {
                result = result.Where(c => c.Artikel != null && c.Artikel.Contains(artikelFilter, StringComparison.CurrentCultureIgnoreCase));
            }



            return result;
        }
    }




