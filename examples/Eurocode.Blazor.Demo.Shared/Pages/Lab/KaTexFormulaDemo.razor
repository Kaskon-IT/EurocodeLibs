@using EurocodeRazorClassLibrary.Shared
@page "/katex-demo"

<h3>KaTeX Component Full Demo</h3>


<label>Formule:</label>
<input @bind="Formula" placeholder="Typ TeX hier..." class="mt-1 p-1 border w-full" style="width:100%" />
<label>DisplayMode:</label>
<input type="checkbox" @bind="@DisplayMode" />

<br />
<KaTexFormula @bind-Value="Formula" @bind-DisplayMode="@DisplayMode" />



@code {
    private string Formula = @"\int_0^\infty e^{-x^2} dx = \frac{\sqrt{\pi}}{2}";
    private bool DisplayMode{ get; set; }
}
