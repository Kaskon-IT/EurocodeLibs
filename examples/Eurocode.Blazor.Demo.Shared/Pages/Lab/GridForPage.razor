@code {

    [CascadingParameter]
    public SampleProject? SampleProject { get; set; }


    private List<BaseEurocodeContext> MyContexts { get; set; } = [];


    private IEnumerable<BaseEurocodeContext> GetNestedContexts(object obj)
    {
        if (obj == null)
            yield break;

        var type = obj.GetType();

        foreach (var prop in type.GetProperties(BindingFlags.Public | BindingFlags.Instance))
        {
            if (typeof(BaseEurocodeContext).IsAssignableFrom(prop.PropertyType))
            {
                var value = prop.GetValue(obj) as BaseEurocodeContext;
                if (value != null)
                    yield return value;
            }

            if (typeof(IEnumerable<BaseEurocodeContext>).IsAssignableFrom(prop.PropertyType))
            {
                var collection = prop.GetValue(obj) as IEnumerable<BaseEurocodeContext>;
                if (collection != null)
                {
                    foreach (var item in collection)
                        yield return item;
                }
            }
        }
    }

    //private SampleModel model = new();
    private HashSet<string> visibleCols = new();
    private string modelDump => System.Text.Json.JsonSerializer.Serialize(SampleProject?.Beton, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });

    private bool showLabel = true;
    private bool showSymbol = true;
    private bool showValue = true;
    private bool showUnit = true;
    private bool showArticle = true;
    private bool showFormula = !false;
    private bool readOnly = true;

    protected override void OnInitialized()
    {
        visibleCols = new HashSet<string>(new[] { "Label", "Symbol", "Value", "Unit", "Article", "Formula" });

        MyContexts.Add(SampleProject?.DoorbuigingDemo);
        MyContexts.Add(SampleProject?.DoorbuigingDemo.KruipKrimp);
        MyContexts.Add(SampleProject?.DoorbuigingDemo.Doorbuiging);
        //MyContexts.Add(SampleProject?.DoorbuiDemoging.Beton);


        // MyContexts.Add(SampleProject?.Grondslagen);
        MyContexts.Add(SampleProject?.Beton);
        // MyContexts.Add(SampleProject?.Dekking);

        // SampleProject?.ScheurwijdteDemo.BerekenEnValideer(); // wacht eens even, dit moet net als alle andere automatisch gaan!
        // MyContexts.Add(SampleProject?.ScheurwijdteDemo);
        // MyContexts.Add(SampleProject?.Belastingen);


        UpdateVisibility();
    }

    private void ToggleAll()
    {
        UpdateVisibility();

        

        //if (visibleCols.Count > 0) visibleCols.Clear();
        //else visibleCols = new HashSet<string>(new[] { "Label", "Symbol", "Value", "Unit", "Description", "Formula" });
    }

    // bind checkboxes to update visibleCols
    private void UpdateVisibility()
    {
        visibleCols.Clear();
        if (showLabel) visibleCols.Add("Label");
        if (showSymbol) visibleCols.Add("Symbol");
        if (showValue) visibleCols.Add("Value");
        if (showUnit) visibleCols.Add("Unit");
        if (showArticle) visibleCols.Add("Article");
        if (showFormula) visibleCols.Add("Formula");
    }

    // hook checkboxes so changing them updates visibleCols immediately
    // simplest approach: use property setters that call UpdateVisibility,
    // but here call UpdateVisibility from UI events or two-way bind with onchange.
    // for brevity, call UpdateVisibility in OnParametersSet of parent as needed
    private Task OnModelChanged(BetonContext m)
    {
        // model bijgewerkt door GridFor
        return Task.CompletedTask;
    }
}
