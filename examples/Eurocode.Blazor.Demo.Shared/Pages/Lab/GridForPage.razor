            EurocodeContext = SampleProject.DoorbuigingDemo;

            MyContexts.Add(SampleProject.DoorbuigingDemo);
            MyContexts.Add(SampleProject.DoorbuigingDemo.KruipKrimpBerekening);
            MyContexts.Add(SampleProject.DoorbuigingDemo.DoorbuigingBerekening);
            MyContexts.Add(SampleProject.DoorbuigingDemo.BuigingBerekening);
            MyContexts.Add(SampleProject.DoorbuigingDemo.Beton);
            MyContexts.Add(SampleProject.DoorbuigingDemo.Beton.BetonStaal);
            MyContexts.Add(SampleProject.DoorbuigingDemo.Beton.Profiel);

           

