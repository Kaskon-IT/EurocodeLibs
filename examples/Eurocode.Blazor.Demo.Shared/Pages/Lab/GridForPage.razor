@page "/Lab/gridforpage"
@using System.Collections.Generic
@using CommonLibrary
@using EurocodeRazorClassLibrary.Shared
@using System.Reflection


@if (SampleProject == null)
{
    <p>Geen model geladen</p>
}
else
{
    <div>
       <label><input type="checkbox" @bind="readOnly" /> ReadOnly</label>
       <label><input type="checkbox" @bind="showNonEditables" /> Non-Input</label>

    </div>

    <NumberFormatterSettings />

    <p>Count: @MyContexts.Count</p>

    @if(EurocodeContext != null)
    {
        <MyGridFor @bind-Model="EurocodeContext"
                   @bind-VisibleColumns="visibleCols"
                   ReadOnly="@readOnly"
                   ShowNonEditables="@showNonEditables"
                   @key="EurocodeContext.Id" />

        var nestedCtxen = GetNestedContexts(EurocodeContext).ToList();
        
        @* Recursief nested contexten tonen *@
        List<Guid> guids = [];
        for (int j = 0; j < nestedCtxen.Count; j++)
        {
            var nidx = j; // fix closure

            // voorkom dubbele keys
            if (!guids.Contains(nestedCtxen[nidx].Id))
            {
                <MyGridFor @bind-Model="nestedCtxen[nidx]"
                           @bind-VisibleColumns="visibleCols"
                           ReadOnly="@readOnly"
                @key="nestedCtxen[nidx].Id" />
            }

        }
    }
    else
    {
        @for (int i = 0; i < MyContexts.Count; i++)
        {
            var idx = i; // <-- nog steeds nodig om closure te fixen



            <MyGridFor @bind-Model="MyContexts[idx]"
                       @bind-VisibleColumns="visibleCols"
                       ReadOnly="@readOnly"
                       ShowNonEditables="@showNonEditables"
                       @key="MyContexts[idx].Id" />


        }

    }


   

   
  


    @* <pre>@modelDump</pre> *@
}



@code {

    [CascadingParameter]
    public SampleProject? SampleProject { get; set; }


    private List<BaseEurocodeContext> MyContexts { get; set; } = [];
    private BaseEurocodeContext? EurocodeContext { get; set; } = null;


    private IEnumerable<BaseEurocodeContext> GetNestedContexts(object obj)
    {
        if (obj == null)
            yield break;

        var type = obj.GetType();

        foreach (var prop in type.GetProperties(BindingFlags.Public | BindingFlags.Instance))
        {
            if (typeof(BaseEurocodeContext).IsAssignableFrom(prop.PropertyType))
            {
                var value = prop.GetValue(obj) as BaseEurocodeContext;
                if (value != null)
                    yield return value;
            }

            if (typeof(IEnumerable<BaseEurocodeContext>).IsAssignableFrom(prop.PropertyType))
            {
                var collection = prop.GetValue(obj) as IEnumerable<BaseEurocodeContext>;
                if (collection != null)
                {
                    foreach (var item in collection)
                        yield return item;
                }
            }
        }
    }

    //private SampleModel model = new();
    private HashSet<string> visibleCols = new();
    //private string modelDump => System.Text.Json.JsonSerializer.Serialize(SampleProject?.Beton, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });

    private bool readOnly = !true;
    private bool showNonEditables = !true;

