@using ExportFactory;
@using ExportFactory.Extensions;
@using Eurocode.BetonConstructies;

@if (SampleProject != null)
{
    <EurocodeBetonDuurzaamheid @bind-Model="@SampleProject.Dekking"></EurocodeBetonDuurzaamheid>
    <FluentButton OnClick="Export">Export HTML</FluentButton>

   

   @*  <ExportTableComponent 
        Item="@SampleProject.Dekking"
        T="BetonDekkingContext"></ExportTableComponent> *@
}

@if (!string.IsNullOrEmpty(html)){
    <div>@((MarkupString)html)</div>
}



@code {
    [CascadingParameter]
    public SampleProject? SampleProject { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private string html { get; set; } = "";
    private void Export(){
        if (SampleProject == null) return;
        List<Eurocode.BetonConstructies.BetonDekkingContext> list = [SampleProject.Dekking];
        var dataTable = list.ToDataTable();
        var table = dataTable.ToMigraDocTable(typeof(BetonDekkingContext));
        MigraDoc.DocumentObjectModel.Document document = new();
        document.AddSection().Add(table);
        html = ExportFactory.Services.HtmlCreator.GenerateHtmlFromDocument(document);
    }

}