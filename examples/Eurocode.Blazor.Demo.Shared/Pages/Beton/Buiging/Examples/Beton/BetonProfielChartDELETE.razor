        if (Model == null) return;

        var startDate = DateTime.Now;

        config = new Config
            {
                //AutoSizable = true,
                Responsive = true,
                Editable = !true,

            };

        layout = new Layout
            {
                //AutoSize = true,
                Title = new Title
                {
                    Text = "Profiel"
                },
                XAxis = new List<XAxis>(){
                new()
                {
                    //AutoRange = Plotly.Blazor.LayoutLib.XAxisLib.AutoRangeEnum.True,
                    Title = new(){Text = "Breedte [mm]"},
                    ShowGrid = false,
                    ShowLine = false,
                    ZeroLine = false,
                    Tick0 = 0,

                }
            },
                YAxis = new List<YAxis>(){
                new()
                {
                    //AutoRange = Plotly.Blazor.LayoutLib.YAxisLib.AutoRangeEnum.True,
                    Title = new(){Text = "Hoogte [mm]"},
                    ScaleAnchor = "x",
                    ScaleRatio = 1,
                    ShowGrid = false,
                    ZeroLine = false,
                    ShowLine = false,
                    Tick0 = 0,

                }
            },

                //PaperBgColor = Theme.PaletteDark.Surface.ToString(),
                //PlotBgColor = Theme.PaletteDark.Surface.ToString(),
                Font = new Font
                {
                    //Color = Theme.PaletteDark.TextPrimary.ToString()
                },
                Shapes = new List<Shape>()
            {
                new()
                {
                    Name = "Profiel",
                    Type = TypeEnum.Rect,
                    X0 = 0,
                    X1 = Model.Breedte,
                    Y0 = 0,
                    Y1 = Model.Hoogte,
                    XRef = "x",
                    YRef = "y",
                    Line = new()
                    {
                        Width = 1
                    },
                    FillColor = "rgba(84,166,143,1)",
                    Opacity = 0.3m
                },

            }
            };

        data = new List<ITrace>
        {
            new Scatter
            {
                Name = "ScatterTrace",
                Mode = ModeFlag.Markers,
                X = new List<object>{0, Model.Breedte },
                Y = new List<object>{0, Model.Hoogte }
            },
        };

        await UpdateChart(false);
        base.OnInitialized();

    }




    private async Task UpdateChart(bool redraw=true)
    {
        if (Model == null) return;


        var punten = Model.PolygonOmZwPnt;
        if (!TekenVanuitZwaartepunt)
            punten = Model.Polygon;

        var xMin = punten.Min(p => p.X);
        var xMax = punten.Max(p => p.X);
        var yMin = punten.Min(prop => prop.Y);
        var yMax = punten.Max(prop => prop.Y);

        xValues = punten.Select(prop => (object)prop.X).ToList();
        yValues = punten.Select(prop => (object)prop.Y).ToList();

        List<object> xTickValues = [(object)xMin, (object)0, (object)xMax];
        List<object> yTickValues = [(object)yMin, (object)0, (object)yMax];

        //List<object> xTickText = [(object)xMin.ToString(), (object)0, (object)xMax.ToString()];
        //List<object> yTickText = [(object)yMin.ToString(), (object)0, (object)yMax.ToString()];


        data = new List<ITrace>
        {
            new Scatter
            {
                Name = "Polygon",
                Mode = ModeFlag.Lines | ModeFlag.Markers,
                X = xValues,
                Y = yValues,
                ShowLegend = false,
                Fill = FillEnum.ToSelf, 

            },






            // new Scatter{
            //     Name = "Breedte",
            //     Mode = ModeFlag.Markers,
            //     X = new List<object>(){xMin, xMax},
