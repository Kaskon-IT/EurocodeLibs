            //     Y = new List<object>(){(object)Model.Zwaartepunt.Y },
            //     Marker = new Marker(){ Symbol = Plotly.Blazor.Traces.ScatterLib.MarkerLib.SymbolEnum.CircleCrossOpen, Size = 20},
            // }
        };


        if (TekenVanuitZwaartepunt)
        {
            data.Add(new Scatter
                {
                    Name = "Y",
                    Mode = ModeFlag.Lines | ModeFlag.Markers | ModeFlag.Text,
                    X = new List<object>() { (object)0, (object)(xMax + 100) },
                    Y = new List<object>() { (object)0, 0 },
                    Marker = new Marker()
                    {
                        Symbol = Plotly.Blazor.Traces.ScatterLib.MarkerLib.SymbolEnum.Arrow,
                        Color = "green",
                        Size = 20,
                        AngleRef = Plotly.Blazor.Traces.ScatterLib.MarkerLib.AngleRefEnum.Previous
                    },
                    ShowLegend = false,
                    TextArray = ["", "Y-as"],
                    TextPosition = TextPositionEnum.MiddleRight,

                });

            data.Add(new Scatter
                {
                    Name = "Z",
                    Mode = ModeFlag.Lines | ModeFlag.Markers | ModeFlag.Text,
                    X = new List<object>() { (object)0, 0 },
                    Y = new List<object>() { (object)0, (object)(yMax + 100) },
                    Marker = new Marker()
                    {
                        Symbol = Plotly.Blazor.Traces.ScatterLib.MarkerLib.SymbolEnum.Arrow,
                        Color = "blue",
                        Size = 20,
                        AngleRef = Plotly.Blazor.Traces.ScatterLib.MarkerLib.AngleRefEnum.Previous
                    },
                    ShowLegend = false,
                    TextArray = ["", "Z-as"],
                    TextPosition = TextPositionEnum.TopCenter,



                });
        }

        layout.AutoSize = true;
        layout.Height = 500;

        layout.XAxis = new List<XAxis>()
        {
            new(){
                ZeroLine = false,
                ShowLine = false,
                ShowGrid = !false,
                //AutoRange = Plotly.Blazor.LayoutLib.XAxisLib.AutoRangeEnum.Max,
                //Range = new List<object>{0, SampleProject.BendingResults.B},

                //RangeMode = Plotly.Blazor.LayoutLib.XAxisLib.RangeModeEnum.Normal,
                //Tick0 = 0,
                //Ticks = Plotly.Blazor.LayoutLib.XAxisLib.TicksEnum.Outside,
                TickAngle = -90,
                //DTick = Model.Breedte,

                TickMode = Plotly.Blazor.LayoutLib.XAxisLib.TickModeEnum.Array,
                TickVals = xTickValues,
                //TickText = xTickText,

            }
        };

        layout.YAxis = new List<YAxis>(){
            new(){
                  Title = new(){Text = "Hoogte [mm]"},
                    ScaleAnchor = "x",
                    ScaleRatio = 1,
                ZeroLine = false,
                ShowLine = false,
                ShowGrid = !false,

                //RangeMode = Plotly.Blazor.LayoutLib.YAxisLib.RangeModeEnum.Normal,
                //Ticks = Plotly.Blazor.LayoutLib.YAxisLib.TicksEnum.Outside,
                //DTick = Model.Hoogte,
                //Tick0 = 0,

                TickMode = Plotly.Blazor.LayoutLib.YAxisLib.TickModeEnum.Array,
