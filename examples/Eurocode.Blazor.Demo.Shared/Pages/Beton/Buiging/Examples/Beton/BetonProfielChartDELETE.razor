            //     XRef = "x",
            //     YRef = "y",
            //     AXref = "x",
            //     AyRef = "y",
            //     ShowArrow = true,
            //     ArrowSize = 1.5M,
            //     Arrowhead = 2,
            //     ArrowWidth = 2.0M,


            // },
            // new Annotation{
            //     X = ((xMin + xMax) / 2),
            //     Y = yMin - 100 + 50,
            //     Text = (xMax - xMin).ToString("0"),
                
            //     ShowArrow = false,
            //     Font = new Plotly.Blazor.LayoutLib.AnnotationLib.Font(){Family = "Verdana"},

            // }
        };

        layout.Shapes = new List<Shape>()
        {
            // new()
            // {
            //     Name = "Profiel",
            //     Type = TypeEnum.Rect,
            //     X0 = 0,
            //     X1 = Model.Breedte,
            //     Y0 = 0,
            //     Y1 = Model.Hoogte,
            //     XRef = "x",
            //     YRef = "y",
            //     Line = new()
            //     {
            //         Width = 2,
            //         Color = "rgba(0,0,0,1)",
            //     },
            //     //FillColor = "rgba(84,166,143,1)",
            //     Opacity = 0.5m
            // },

        };





        try{

            if (redraw)
            {
                await chart.Update(data, layout); // werkt niet... todo uitzoeken
                await chart.NewPlot();
            }

        }
        catch(Exception ex)
        {
            Console.WriteLine(ex.Message);
        }


      
    }

    

}
