@using Eurocode.BetonConstructies
@using K = CommonLibrary.EurocodeKeys


<EurocodeInputNumber ReadOnly=true Value="Model.MomentFrequent" Key="@K.MomentFrequent" Unit="kNm"></EurocodeInputNumber>
<EurocodeInputNumber ReadOnly=true Value="Model.ScheurwijdteAsMin" Key="@K.ScheurwijdteAsMin" Unit="mm²"></EurocodeInputNumber>
<EurocodeInputNumber ReadOnly=true Value="Model.ScheurwijdteMax" Key="@K.ScheurwijdteMax" Unit="mm"></EurocodeInputNumber>
<EurocodeInputNumber ReadOnly=true Value="Model.Wk" Key="@K.ScheurwijdteBerekend" Unit="mm" MaxValue="Model.ScheurwijdteMax"></EurocodeInputNumber>
<EurocodeInputNumber ReadOnly=true Value="Model.Mcr" Key="@K.MomentScheurmoment" Unit="kNm"></EurocodeInputNumber>



@code {
    [Parameter]
    public ScheurwijdteContext Model { get; set; } = new();
    [Parameter]
    public EventCallback<ScheurwijdteContext> ModelChanged { get; set; }


   

}
