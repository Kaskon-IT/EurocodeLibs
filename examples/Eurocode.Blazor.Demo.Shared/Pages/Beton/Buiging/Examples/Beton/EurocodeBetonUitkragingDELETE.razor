@using Eurocode.BetonConstructies
@using ExportFactory.Services
@using K = ExportFactory.Services.MappingKeys

<FluentGrid Spacing="0">


    <EurocodeInputNumber @bind-Value="@Model.TandLengte" Key="@K.TandLengte" Unit="mm"
    LabelPosition="@LabelPosition" LabelType="@LabelType" 
    ReadOnly="IsFieldReadOnly(nameof(Model.TandLengte))"  />

    <EurocodeInputNumber @bind-Value="@Model.TandLengte" Key="@K.TandHoogte" Unit="mm"
                         LabelPosition="@LabelPosition" LabelType="@LabelType"
                         ReadOnly="IsFieldReadOnly(nameof(Model.TandHoogte))" />

    <EurocodeInputNumber @bind-Value="@Model.TandNuttigeHoogte" Key="@K.TandNuttigeHoogte" Unit="mm"
    LabelPosition="@LabelPosition" LabelType="@LabelType"
    ReadOnly="IsFieldReadOnly(nameof(Model.TandNuttigeHoogte))" />

    <EurocodeInputNumber @bind-Value="@Model.Reactiekracht" Key="@K.ReactieRekenwaarde" Unit="kN"
                         LabelPosition="@LabelPosition" LabelType="@LabelType"
                         ReadOnly="IsFieldReadOnly(nameof(Model.Reactiekracht))" />

    <EurocodeInputNumber Value="@Model.ArmReactieVerticaal" Key="@K.MomentArm" Unit="mm"
                         LabelPosition="@LabelPosition" LabelType="@LabelType"
                         ReadOnly=true />

    <EurocodeInputNumber Value="@Model.Moment" Key="@K.MomentRekenwaarde" Unit="kNm"
                         LabelPosition="@LabelPosition" LabelType="@LabelType"
                         ReadOnly=true />

    <FluentCheckbox Value=@Model.IsGedrongenLigger ReadOnly=true>Gedrongen?</FluentCheckbox>


    @* <EurocodeBetonDwarskrachtComponent ReadOnlyFields="@ReadOnlyFields"  *@
                                       @* Model="@Model.TandShear"></EurocodeBetonDwarskrachtComponent>  *@





</FluentGrid>




@code {
    /// <summary>
    /// Het model
    /// </summary>
    [Parameter, EditorRequired]
    public required UitkragingContext Model { get; set; }


    /// <summary>
    /// Callback is nodig voor @bind-Model
    /// </summary>
    [Parameter]
    public EventCallback<UitkragingContext> ModelChanged { get; set; }



    [Parameter]
    public LabelType LabelType { get; set; } = LabelType.SymbolAndDescription;

    [Parameter]
    public LabelPosition LabelPosition { get; set; } = LabelPosition.Left;

    [Parameter]
    public Dictionary<string, bool> ReadOnlyFields { get; set; } = new();


    private bool IsFieldReadOnly(string fieldName) =>
        ReadOnlyFields.TryGetValue($"{fieldName}", out var isReadOnly) && isReadOnly;


    


    protected override void OnInitialized()
    {
        //Model = new(Beton, Profiel, 100);
        //Model = new();
        //Model.Update();

    }

    protected override void OnParametersSet()
    {
        Model.Bereken();
        //Console.WriteLine($"Model R={Model?.OplegReactieRekenwaarde.ToString()}");
        //Model.Update(); // niet doen
    }






}
