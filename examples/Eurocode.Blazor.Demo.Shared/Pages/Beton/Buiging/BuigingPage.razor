@page "/beton/buiging"
@using Eurocode.Blazor.Demo.Shared.Pages.Beton.Buiging.Examples

<h3>Buiging basis</h3>
<p>Gebruikte materialen voor de componenten op deze pagina</p>

@* <EurocodeBetonMaterialen @bind-Model="@SampleProject.BendingResults.Beton" 
                         ShowUserFriendly=true></EurocodeBetonMaterialen> *@

@if (SampleProject != null)
{
    <EurocodeBetonMaterialen @bind-Model="@SampleProject.BendingResults.Beton"></EurocodeBetonMaterialen>
    <FluentButton OnClick="ChangeState">Ververs handmatig</FluentButton>

    <BuigingBasicComponent @bind-Model="SampleProject.BendingResults"></BuigingBasicComponent>

}

    <h2>Voorbeelden</h2>
    <DemoSection Title="Basic" Component="typeof(BuigingBasisDefault)"/>

    <ApiDocumentation Component="typeof(BuigingBasic)" />
    <ApiDocumentation Component="typeof(PlotlyChart)" />


@code {
    [CascadingParameter]
    public SampleProject? SampleProject { get; set; }

    public void ChangeState()
        {
        StateHasChanged();
        }
}
