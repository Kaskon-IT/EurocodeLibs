@using Microsoft.FluentUI.AspNetCore.Components

@code {
    [Parameter]
    public bool IsLoading { get; set; }
}

@if (IsLoading)
{
    <div class="loading-overlay">
        <FluentProgressRing/>
    </div>
}

<style>
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(255, 255, 255, 0.7);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }
</style>
