<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <PackageId>Kaskon.CommonLibrary</PackageId>
	  <Version>5.0.0</Version>
	  <Authors>Bart van der Linden</Authors>
	  <Company>Kaskon</Company>
	  <Description>Library voor veelgebruikte extensions, helpers, interfaces en meer.</Description>
	  <PackageLicenseFile>license.md</PackageLicenseFile>
      <PackageReadmeFile>readme.md</PackageReadmeFile>
	  <PackageIcon>kaskon.png</PackageIcon>
	  <!-- Lokale map voor .nupkg -->
	  <PackageOutputPath>T:\04 Standaarden\NuGetPackages</PackageOutputPath>
	  <Copyright>Copyright © 2025 Kaskon</Copyright>
	  <PackageTags>Kaskon;Blazor;FluentUI;Eurocode;Beton;Constructies</PackageTags>
	  <IncludeSymbols>true</IncludeSymbols>
	  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	  
  </PropertyGroup>

	
	
	<ItemGroup>
<None Include="Icons/kaskon.png" Pack="true" PackagePath="/" />
<None Include="Docs/license.md" Pack="true" PackagePath="/" />
<None Include="Docs/readme.md" Pack="true" PackagePath="/" />
</ItemGroup>	
	
									
  <ItemGroup>
    <PackageReference Include="Kaskon.Algemeen" Version="1.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="9.0.10" />
    <PackageReference Include="MigraDoc.DocumentObjectModel.Core" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Libs\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Docs\license.md">
      <PackagePath>/</PackagePath>
      <Pack>true</Pack>
    </None>
    <None Update="Docs\readme.md">
      <PackagePath>/</PackagePath>
      <Pack>true</Pack>
    </None>
    <None Update="Icons\kaskon.png">
      <PackagePath>/</PackagePath>
      <Pack>true</Pack>
    </None>
  </ItemGroup>

</Project>
