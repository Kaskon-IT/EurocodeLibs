    protected void OnParametersSetVERWIJDER_NA_SUCCES()
    {
        VisibleColumns ??= new HashSet<string>(new[] { "Label", "Symbol", "Value", "Unit", "Article", "Formula" });

        // info
        if (Model is BaseEurocodeContext bec)
        {
            Heading = bec.Heading;
        }

        ResetRows();

        

    }


    private async void OnValueChangedVERWIJDEREN_NA_SUCCES(PropertyInfo property, string? newValue)
    {
        if (newValue is null) return;

        var targetType = Nullable.GetUnderlyingType(property.PropertyType) ?? property.PropertyType;
        if (TryConvertStringToType(newValue, targetType, out var converted))
        {
            property.SetValue(Model, converted);

            // update _rows, maar open rijen blijven correct
            _rows = TableColumnAttributeHelper.GetRows(Model!).ToList();

            if (ModelChanged.HasDelegate)
                await ModelChanged.InvokeAsync(Model);

            StateHasChanged();
        }
    }

    private async void OnValueChanged(PropertyInfo property, string? newValue)
    {
        if (newValue is null) return;

        var targetType = Nullable.GetUnderlyingType(property.PropertyType) ?? property.PropertyType;
        if (TryConvertStringToType(newValue, targetType, out var converted))
        {
            property.SetValue(Model, converted);

            // Alleen de DisplayValue bijwerken
            var row = _rows.OfType<PropertyRow>().FirstOrDefault(r => r.Property == property);
            if (row != null)
            {
                row.DisplayValue = converted?.ToString() ?? "";
            }

            if (ModelChanged.HasDelegate)
                await ModelChanged.InvokeAsync(Model);

            StateHasChanged();
        }
    }




    private async void OnValueChangedBakBeforeIssueWithDichtklappenExtraInfo(PropertyInfo property, string? newValue)
    {
        if (newValue is null) return;

        var targetType = Nullable.GetUnderlyingType(property.PropertyType) ?? property.PropertyType;
        if (TryConvertStringToType(newValue, targetType, out var converted))
        {
            property.SetValue(Model, converted);
            // refresh rows cache to reflect the new value
            _rows = TableColumnAttributeHelper.GetRows(Model!).ToList();

            if (ModelChanged.HasDelegate)
                await ModelChanged.InvokeAsync(Model);
            StateHasChanged();
        }
        else
        {
            // fallback / validation: nu doen we niets; je kan hier een foutmelding tonen
        }
    }

    private bool TryConvertStringToType(string s, Type targetType, out object? result)
    {
        result = null;

        if (targetType.IsEnum)
        {
            try
            {
                result = Enum.Parse(targetType, s, ignoreCase: true);
                return true;
            }
            catch
            {
                return false;
            }
        }

        if (targetType == typeof(string))
        {
            result = s;
            return true;
        }

        var nfi = CultureInfo.InvariantCulture;

        if (targetType == typeof(int))
        {
            if (int.TryParse(s, NumberStyles.Integer, nfi, out var v)) { result = v; return true; }
            return false;
        }
        if (targetType == typeof(long))
        {
            if (long.TryParse(s, NumberStyles.Integer, nfi, out var v)) { result = v; return true; }
            return false;
        }
        if (targetType == typeof(double))
        {
            if (double.TryParse(s, NumberStyles.Float | NumberStyles.AllowThousands, nfi, out var v)) { result = v; return true; }
            return false;
        }
        if (targetType == typeof(float))
        {
            if (float.TryParse(s, NumberStyles.Float | NumberStyles.AllowThousands, nfi, out var v)) { result = v; return true; }
            return false;
        }
        if (targetType == typeof(decimal))
        {
            if (decimal.TryParse(s, NumberStyles.Number, nfi, out var v)) { result = v; return true; }
            return false;
        }
        if (targetType == typeof(bool))
        {
            if (bool.TryParse(s, out var v)) { result = v; return true; }
            return false;
        }

        try
        {
            result = Convert.ChangeType(s, targetType, CultureInfo.InvariantCulture);
            return true;
        }
        catch
        {
            return false;
        }
    }


    private RenderFragment RenderInput(PropertyInfo property) => builder =>
{
    var value = property.GetValue(Model);
    var targetType = Nullable.GetUnderlyingType(property.PropertyType) ?? property.PropertyType;

    // Wrappen in <td>
    builder.OpenElement(0, "td");

    string style = "width:100%; min-width:0; padding:4px 6px; " +
                   "border:1px solid #d1d1d1; border-radius:4px; " +
                   "box-sizing:border-box; font-size:0.9rem;";

    // Enum → select
    if (targetType.IsEnum)
    {
        builder.OpenElement(1, "select");
        builder.AddAttribute(2, "style", style);
        builder.AddAttribute(3, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
            e => OnValueChanged(property, e?.Value?.ToString())));

        int seq = 4;
        foreach (var enumVal in Enum.GetValues(targetType))
        {
            builder.OpenElement(seq++, "option");
            builder.AddAttribute(seq++, "value", enumVal);
            builder.AddAttribute(seq++, "selected", value?.ToString() == enumVal.ToString());
            builder.AddContent(seq++, enumVal.ToString());
            builder.CloseElement();
        }

        builder.CloseElement();
    }
    // Boolean → checkbox
    else if (targetType == typeof(bool))
    {
        builder.OpenElement(1, "input");
        builder.AddAttribute(2, "type", "checkbox");
        builder.AddAttribute(3, "class", "table-checkbox");
        builder.AddAttribute(4, "checked", (bool)(value ?? false));
        builder.AddAttribute(5, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
            e => OnValueChanged(property, e?.Value?.ToString())));
        builder.CloseElement();
    }
    else if (typeof(BaseEurocodeContext).IsAssignableFrom(targetType))
    {
        // recursief
        RenderDynamic(targetType, Model);
        builder.OpenElement(1, "p");
        builder.AddContent(2, "zie tabel");
        builder.CloseElement();
    }

    // Alles anders → input type afhankelijk van TypeCode
    else
    {
        string typeAttr = Type.GetTypeCode(targetType) switch
        {
            TypeCode.Int32 =>"number",
            TypeCode.Double or TypeCode.Single or TypeCode.Decimal => "text",
            TypeCode.DateTime => "date",
            _ => "text"
        };

        string valueAttr = TypeCode.DateTime == Type.GetTypeCode(targetType) && value is DateTime dt
            ? dt.ToString("yyyy-MM-dd")
            : value?.ToString() ?? "";

        builder.OpenElement(1, "input");
        builder.AddAttribute(2, "type", typeAttr);
        builder.AddAttribute(3, "style", style);
        builder.AddAttribute(4, "value", valueAttr);
        builder.AddAttribute(5, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
            e => OnValueChanged(property, e?.Value?.ToString())));
        builder.CloseElement();
    }

    builder.CloseElement(); // td sluiten
};


    RenderFragment RenderDynamic(Type t, object model) => builder =>
    {
        var seq = 0;
        var genericType = typeof(MyGridFor<>).MakeGenericType(t);
        builder.OpenComponent(seq++, genericType);
        builder.AddAttribute(seq++, "Model", model);
        builder.AddAttribute(seq++, "TModel", genericType);
        builder.CloseComponent();
    };


