    private bool Hidden { get; set; }
    private void ToggleHidden(bool hidden)
    {
        Hidden = !hidden;
    }

    private bool IsVisible(string col) => VisibleColumns.Contains(col);

    private async Task ToggleColumn(string col)
    {
        if (VisibleColumns.Contains(col))
            VisibleColumns.Remove(col);
        else
            VisibleColumns.Add(col);

        await VisibleColumnsChanged.InvokeAsync(VisibleColumns);
    }


    private List<IPropertyRow> _rows = new();
    private List<IPropertyRow> _rawRows = new();

    private void ResetRows()
    {
        // caching zodat we stabiel itereren en makkelijk kunnen refreshen na set
        _rows = _rawRows
        .Where(r =>
            (r as PropertyRow)?.Editable == true ||
            (r as SubPropertyRow)?.Value != null ||
            ShowNonEditables
        )
        .OrderByDescending(r => (r as PropertyRow)?.Editable)
        .ThenByNatural(r => (r as PropertyRow)?.Symbol)
        .ThenByNatural(r => (r as PropertyRow)?.Article)
        .ThenByNatural(r => (r as PropertyRow)?.Formula?.Name)

        .ToList();

        // geen info gevonden
        if (_rows.Count == 0)
        {
            _rows.Add(new SubPropertyRow(Guid.NewGuid().ToString(), "📭", "geen eigenschappen gevonden", "" ));
        }

    }

    private void OnShowNonEditablesChanged()
    {
        // gebruik deze void zodat de waarde eerst gewijzigd is voordat we verder gaan.
        ResetRows();
        StateHasChanged(); // niet nodig, maar tijdelijk voor debug
    }

    protected override void OnInitialized()
    {
        // NB. Gebruik OnUpdated in plaats van PropertyChanged
        // dit voorkomt het ophalen van 'oude' data. 
        // of data die nog niet bijgewerkt is.
        // OnUpdated wordt pas afgevuurd als alles klaar is.

        // eerste keer sowieso ophalen
        _rawRows = TableColumnAttributeHelper.GetRows(Model, 0, 0).ToList();
        ResetRows();

        // dan als het model klaar is (na alle wijzigingen)
        Model.OnUpdated += () =>
        {
            _rawRows = TableColumnAttributeHelper.GetRows(Model, 0, 0).ToList();
            ResetRows();
            InvokeAsync(StateHasChanged);
        };
    }



