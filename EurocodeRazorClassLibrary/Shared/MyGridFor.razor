@typeparam TModel where TModel : BaseEurocodeContext
@using System.Globalization
@using System.Reflection
@using CommonLibrary
@using CommonLibrary.Extensions
@using CommonLibrary.Models
@using ExportFactory.Services
@using ExportFactory.Shared
@using Microsoft.FluentUI.AspNetCore.Components
@using System.ComponentModel

@inherits BaseEurocodeComponent

<div id="@GridId">


    <div class="mijn-component">
        <table class="striped-table responsive-table">

    @if (ShowCaption)
            {
                <caption style="caption-side:top; padding-bottom:0px; ">
                    @Model.Heading
                </caption>
            }

      

            <colgroup>
                <col style="width: auto;">       <!-- opvullende kolom -->
                <col style="width: 120px;">      <!-- vaste -->
                <col style="width: 120px;">      <!-- vaste -->
                <col style="width: 120px;">      <!-- vaste -->
            </colgroup>


            <tbody>

                @if (!Hidden)
                {
                    // uitzonderingen
                    if (Model is Eurocode.BetonConstructies.BetonContext c)
                    {
                        <FluentCard Height="200px" Width="100%">
                            <EurocodeRazorClassLibrary.Beton.BetonMateriaalSpanningRekDiagrammen Beton="c" />

                        </FluentCard>
                    }
                    if (Model is Eurocode.BetonConstructies.BetonStaalContext s)
                    {
                        <FluentCard Height="200px" Width="100%">
                            <EurocodeRazorClassLibrary.Beton.BetonMateriaalSpanningRekDiagrammen BetonStaal="s" />

                        </FluentCard>
                    }




                    @foreach (var iRow in _rows)
                    {
                        if (iRow is PropertyRow row)
                        {
                            // geef een key mee voor
                            <tr @key=row.Id>

                                @* 1e kolom *@
                                <td>
                                    <dl style="margin-bottom:1px;">
                                        <dt class="katex-like">@((MarkupString)(row.Symbol ?? ""))</dt>

                                        @if (row.Description != null && ShowDescription)
                                        {
                                        <dd>@((MarkupString)(row.Description ?? ""))</dd>
                                        }
                                        else
                                        {
                                        <dd>@((MarkupString)row.Label)</dd>
                                        }

                                        @if (row.Article != null && ShowArticles)
                                        {
                                        <dt>artikel</dt>
                                        <dd>@row.Article</dd>
                                        }

                                        @if (row.Formula != null && ShowFormulas)
                                        {
                                        <dt>vgl.</dt>
                                        <dd>
                                            <KaTexFormula Value="@row.Formula?.GetValue()"
                                                          Label="@row.Formula?.Name"
                                                          Small="true"
                                                          DisplayMode="false" />
                                        </dd>
                                        }
                                    </dl>
                        

                                </td>

                                @* 2e kolom *@
                                <td class="katex-like">
                                    @((MarkupString)((row.Symbol ?? "") + (!string.IsNullOrEmpty(row.Symbol) ? " =" : "")))
                                </td>

                                @* 3e kolom *@
                                @if (row.Editable && !ReadOnly)
                                {
                                    @RenderInput(row.Property)
                                }
                                else
                                {
                                    <td>
                                        @row.DisplayValue
                                    </td>
                                }

                                <td>@((MarkupString)(row.Unit ?? ""))</td>




                            </tr>

                        } // end if (iRow is PropertyRow row)
                        else if (iRow is SubPropertyRow subRow)
                        {   
                            <tr @key=subRow.Id>
                                @* 1e kolom over 4 kolommen*@
                                <td colspan="4">
                                    <dl>
                                        <dt>@subRow.Label</dt>
                                        <dd>@((MarkupString)subRow.Value)</dd>
                                    </dl>

                                </td>
                            </tr>
                        }
                    }
                }

            </tbody>
        </table>
    </div>

</div>




<FluentMenu Anchor="@GridId" Trigger="MouseButton.Right" Anchored="false" @onmenuchange="OnMenuChange">
    
    <FluentMenuItem Id="ckDesc" Role="MenuItemRole.MenuItemCheckbox" @bind-Checked=ShowDescription>
        Omschrijving
    </FluentMenuItem>
    <FluentMenuItem Id="ckArt" Role="MenuItemRole.MenuItemCheckbox" @bind-Checked=ShowArticles>
        Artikel
    </FluentMenuItem>
    <FluentMenuItem Id="ckFormulas" Role="MenuItemRole.MenuItemCheckbox" @bind-Checked=ShowFormulas>
        Formules
    </FluentMenuItem>


    <FluentDivider></FluentDivider>

    <FluentSwitch @bind-Value="ShowNonEditables"
                  @bind-Value:after="OnShowNonEditablesChanged"
                  Style="margin-left: 20px;"
                  UncheckedMessage="toon invoer"
                  CheckedMessage="alle rijen" />
</FluentMenu>



@code {
        [Parameter, EditorRequired] public TModel Model { get; set; } = default!;
        [Parameter] public EventCallback<TModel> ModelChanged { get; set; }

        [Parameter] public bool ReadOnly { get; set; } = false; // standaard bewerkbaar
        [Parameter] public EventCallback<bool> ReadOnlyChanged { get; set; }

        //[Parameter] public bool IsInklapbaar{ get; set; }
        [Parameter] public bool ShowCaption { get; set; } = true;


        [Parameter] public bool ShowDescription { get; set; } = !true; // standaard uit, toont label

        [Parameter] public bool ShowArticles { get; set; } = !true; // standaard geen artikelen tonen

        [Parameter] public bool ShowFormulas { get; set; } = !true; // standaard geen formules tonen


        [Parameter] public bool ShowNonEditables { get; set; } = !true; // standaard alleen invoer tonen
        [Parameter] public EventCallback<bool> ShowNonEditablesChanged { get; set; }





        // Geef parent de mogelijkheid runtime kolommen te tonen/verbergen.
        [Parameter] public HashSet<string> VisibleColumns { get; set; } = new();
        [Parameter] public EventCallback<HashSet<string>> VisibleColumnsChanged { get; set; }

    private string GridId => $"grid_{Model.Id:N}";
    private string status = "";

    private void OnMenuChange(MenuChangeEventArgs args)
    {
        if (args is not null && args.Value is not null)
            status = $"Item \"{args.Value}\" clicked";
    }




    private FluentMenu? ContextMenuRef;

    private void HandleMouseDown(MouseEventArgs e)
    {
        if (e.Button == 2) // rechter muisklik
        {
            MenuX = e.ClientX;
            MenuY = e.ClientY;
            IsMenuOpen = true;
            StateHasChanged();
        }
        else
        {
            IsMenuOpen = false; // sluit menu bij linkermuisklik
        }
    }



    private void OnTableRightClick(MouseEventArgs e)
    {
        if (ContextMenuRef != null)
        {
            // open FluentMenu programmatically bij cursor
            MenuX = e.ClientX;
            MenuY = e.ClientY;
            IsMenuOpen = true;
        }
    }



    private bool IsMenuOpen { get; set; } = false;
    private double MenuX;
    private double MenuY;
    private string MenuStyle => $"position:absolute; left:{MenuX}px; top:{MenuY}px;";



    private void ToggleMenu()
    {
        IsMenuOpen = !IsMenuOpen;
    }




    private bool AllRowsOpen { get; set; } = false;

    [Obsolete ("use Model.Heading instead")]
    private string Heading { get; set; } = "";

    private HashSet<PropertyInfo> openRowProperties = new();


    //private HashSet<PropertyRow> openRows = new();
    private void ToggleRowDetails(PropertyRow row)
    {
        if (!openRowProperties.Add(row.Property!))
            openRowProperties.Remove(row.Property!);
    }

    [Obsolete("Niet meer doen")]
    private void ToggleDetails()
    {
        //ShowNonEditables = !ShowNonEditables;

        if (ShowNonEditables)
        {
            openRowProperties = _rows.Select(r => (r as PropertyRow)?.Property!).
            ToHashSet();

            AllRowsOpen = true;
        }
        else
        {
            openRowProperties.Clear();
            AllRowsOpen = false;
        }


    }


    private void ToggleAllRows()
    {
        if (AllRowsOpen)
        {
            // Alles sluiten
            openRowProperties.Clear();
            AllRowsOpen = false;
        }
        else
        {
            // Alles openen
            openRowProperties = _rows
                //.Where(r => r.Description != null || r.Formula != null || r.Article != null)
                .Select(r => (r as PropertyRow)?.Property!)
                .ToHashSet();

            AllRowsOpen = true;
        }
    }






    private bool Hidden { get; set; }
    private void ToggleHidden(bool hidden)
    {
        Hidden = !hidden;
    }

    private bool IsVisible(string col) => VisibleColumns.Contains(col);

    private async Task ToggleColumn(string col)
    {
        if (VisibleColumns.Contains(col))
            VisibleColumns.Remove(col);
        else
            VisibleColumns.Add(col);

        await VisibleColumnsChanged.InvokeAsync(VisibleColumns);
    }


    private TModel? _previousModel;
    private List<IPropertyRow> _rows = new();
    private List<IPropertyRow> _rawRows = new();

    private void ResetRows()
    {
        // caching zodat we stabiel itereren en makkelijk kunnen refreshen na set
        _rows = _rawRows
        .Where(r =>
            (r as PropertyRow)?.Editable == true ||
            (r as SubPropertyRow)?.Value != null ||
            ShowNonEditables
        )
        .OrderByDescending(r => (r as PropertyRow)?.Editable)
        .ThenByNatural(r => (r as PropertyRow)?.Symbol)
        .ThenByNatural(r => (r as PropertyRow)?.Article)
        .ThenByNatural(r => (r as PropertyRow)?.Formula?.Name)

        .ToList();

        // geen info gevonden
        if (_rows.Count == 0)
        {
            _rows.Add(new SubPropertyRow(Guid.NewGuid().ToString(), "📭", "geen eigenschappen gevonden", ""));
        }

    }

    private void OnShowNonEditablesChanged()
    {
        // gebruik deze void zodat de waarde eerst gewijzigd is voordat we verder gaan.
        ResetRows();
        StateHasChanged(); // niet nodig, maar tijdelijk voor debug
    }

    protected override void OnInitialized()
    {
        _rawRows = TableColumnAttributeHelper.GetRows(Model!)
        .ToList();
    }

    protected override void OnParametersSet()
    {
        if (_previousModel is INotifyPropertyChanged old)
            old.PropertyChanged -= OnModelPropertyChanged;

        if (Model is INotifyPropertyChanged npc)
            npc.PropertyChanged += OnModelPropertyChanged;

        _previousModel = Model;

        // dit wil ik eigenlijk niet 
        _rawRows = TableColumnAttributeHelper.GetRows(Model).ToList();
        ResetRows();

    }

