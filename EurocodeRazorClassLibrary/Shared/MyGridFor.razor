<div id="@GridId">


    <div class="mijn-component">
        <table class="striped-table responsive-table">

    @if (ShowCaption)
            {
                <caption style="caption-side:top; padding-bottom:0px; ">
                    @Model.Heading
                </caption>
            }

      

            <colgroup>
                <col style="width: auto;">       <!-- opvullende kolom -->
                <col style="width: 120px;">      <!-- vaste -->
                <col style="width: 120px;">      <!-- vaste -->
                <col style="width: 120px;">      <!-- vaste -->
            </colgroup>


            <tbody>

                @if (!Hidden)
                {
                    // uitzonderingen
                    if (Model is Eurocode.BetonConstructies.BetonContext c)
                    {
                       @*  <FluentCard Height="200px" Width="100%">
                            <EurocodeRazorClassLibrary.Beton.BetonMateriaalSpanningRekDiagrammen Beton="c" />

                        </FluentCard> *@
                    }
                    if (Model is Eurocode.BetonConstructies.BetonStaalContext s)
                    {
                        @* <FluentCard Height="200px" Width="100%">
                            <EurocodeRazorClassLibrary.Beton.BetonMateriaalSpanningRekDiagrammen BetonStaal="s" />

                        </FluentCard> *@
                    }




                    @foreach (var iRow in _rows)
                    {
                        if (iRow is PropertyRow row)
                        {
                            // geef een key mee voor
                            <tr @key=row.Key>

                                @* 1e kolom *@
                                <td>
                                    <dl style="margin-bottom:1px;">
                                        <dt class="katex-like">@((MarkupString)(row.Symbol ?? ""))</dt>

                                        @if (row.Description != null && ShowDescription)
                                        {
                                        <dd>@((MarkupString)(row.Description ?? ""))</dd>
                                        }
                                        else
                                        {
                                        <dd>@((MarkupString)row.Label)</dd>
                                        }

                                        @if (row.Article != null && ShowArticles)
                                        {
                                        <dt>artikel</dt>
                                        <dd>@row.Article</dd>
                                        }

                                        @if (row.Formula != null && ShowFormulas)
                                        {
                                        <dt>vgl.</dt>
                                        <dd>
                                            <KaTexFormula Value="@row.Formula?.GetValue()"
                                                          Label="@row.Formula?.Name"
                                                          Small="true"
                                                          DisplayMode="false" />
                                        </dd>
                                        }
                                    </dl>
                        

                                </td>

                                @* 2e kolom *@
                                <td class="katex-like">
                                    @((MarkupString)((row.Symbol ?? "") + (!string.IsNullOrEmpty(row.Symbol) ? " =" : "")))
                                </td>

                                @* 3e kolom *@
                                @if (row.Editable && !ReadOnly)
                                {
                                    @RenderInput(row)
                                }
                                else
                                {
                                    <td>
                                        @row.DisplayValue
                                    </td>
                                }

                                <td>@((MarkupString)(row.Unit ?? ""))</td>




                            </tr>

                        } // end if (iRow is PropertyRow row)
                        else if (iRow is SubPropertyRow subRow)
                        {   
                            <tr @key=subRow.Key>
                                @* 1e kolom over 4 kolommen*@
                                <td colspan="4">
                                    <dl>
                                        <dt>@subRow.Label</dt>
                                        <dd>@((MarkupString)subRow.Value)</dd>
                                    </dl>

                                </td>
                            </tr>
                        }
                    }
                }

            </tbody>
        </table>
    </div>

</div>




<FluentMenu Anchor="@GridId" Trigger="MouseButton.Right" Anchored="false" @onmenuchange="OnMenuChange">
    
    <FluentMenuItem Id="ckDesc" Role="MenuItemRole.MenuItemCheckbox" @bind-Checked=ShowDescription>
        Omschrijving
    </FluentMenuItem>
    <FluentMenuItem Id="ckArt" Role="MenuItemRole.MenuItemCheckbox" @bind-Checked=ShowArticles>
        Artikel
    </FluentMenuItem>
    <FluentMenuItem Id="ckFormulas" Role="MenuItemRole.MenuItemCheckbox" @bind-Checked=ShowFormulas>
        Formules
    </FluentMenuItem>

   

    <FluentButton Id="btnBijwerken" @onclick="Bijwerken" 
        IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.New())">
        Bijwerken
    </FluentButton>


    <FluentDivider></FluentDivider>

    <FluentSwitch @bind-Value="ShowNonEditables"
                  @bind-Value:after="OnShowNonEditablesChanged"
                  Style="margin-left: 20px;"
                  UncheckedMessage="toon invoer"
                  CheckedMessage="alle rijen" />
</FluentMenu>



@code {
