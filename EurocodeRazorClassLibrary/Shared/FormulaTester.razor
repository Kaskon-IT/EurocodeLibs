@page "/latex-tester"
@inject IJSRuntime JS

<h3>LaTeX Tester</h3>

<FluentTextField @bind-Value="Formula" Label="Voer LaTeX in" Placeholder="bv: E=mc^2" />

<FormulaRenderer Formula="@Formula" Id="testerFormula" @ref="renderer" />

<div style="margin-top:1rem;">
    <FluentButton @onclick="GetSvgAsync">Haal SVG op</FluentButton>
</div>

@if (!string.IsNullOrEmpty(SvgResult))
{
    <div style="margin-top:1rem;">
        <h4>SVG Output</h4>
        <textarea style="width:100%; height:200px;" readonly>@SvgResult</textarea>
        <h4>Inline SVG Preview</h4>
        <div>@((MarkupString)SvgResult)</div>
    </div>
}

@code {
    private string Formula { get; set; } = "E=mc^2";
    private string SvgResult { get; set; } = string.Empty;

    private FormulaRenderer? renderer;

    private async Task GetSvgAsync()
    {
        if (renderer == null) return;

        try
        {
            // Haal de SVG op via de methode van FormulaRenderer
            //SvgResult = await renderer.GetSvgAsync() ?? string.Empty;
        }
        catch (JSDisconnectedException)
        {
            // Veilig negeren als SignalR nog niet connected
            SvgResult = "SignalR niet verbonden, probeer opnieuw.";
        }
        catch (Exception ex)
        {
            SvgResult = $"Fout bij ophalen SVG: {ex.Message}";
        }
    }
}
