@inject IJSRuntime JS

<div id="@Id" @ref="formulaDiv">@((MarkupString)("$" + Formula + "$"))</div>

@code {
    [Parameter]
    public string Formula { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> FormulaChanged { get; set; }

    [Parameter]
    public string Id { get; set; } = "formulaDiv";

    private ElementReference formulaDiv;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SafeRenderAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (formulaDiv.Context != null)
        {
            await SafeRenderAsync();
        }
    }

    private async Task SafeRenderAsync()
    {
        // Wacht tot element in DOM staat
        await Task.Yield();

        try
        {
            await JS.InvokeVoidAsync("MathJax.typesetPromise", new[] { formulaDiv });
        }
        catch (JSDisconnectedException)
        {
            // SignalR nog niet connected → veilig negeren
        }
    }
}



