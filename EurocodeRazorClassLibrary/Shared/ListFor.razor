@code
{ 
    [Parameter, EditorRequired] public TModel Item { get; set; } = default!; 
    [Parameter] public EventCallback<TModel> ItemChanged { get; set; }
    
    // zichtbaarheidsmasker voor kolommen
    [Parameter] public ColumnPart VisibleParts { get; set; } =
        ColumnPart.Header | ColumnPart.Symbol | ColumnPart.Value | ColumnPart.Article | ColumnPart.Formula;

    private static readonly ColumnPart[] _partsOrder = new[]
    {
    ColumnPart.Header, ColumnPart.Symbol, ColumnPart.Value, ColumnPart.Article, ColumnPart.Formula
    };

    private string GridTemplateColumns =>
        string.Join(" ",
            _partsOrder
               .Where(p => VisibleParts.HasFlag(p))
            .Select(_ => "1fr")); // i.p.v. auto vs 1fr → altijd 1fr


    private BaseEurocodeContext? _previousContext;

    protected override void OnParametersSet()
    {
        // afmelden van vorige context
        if (_previousContext is not null)
        {
            _previousContext.OnUpdated -= StateHasChanged;
        }

        // als Item een BaseEurocodeContext is → aanmelden
        if (Item is BaseEurocodeContext ctx)
        {
            _previousContext = ctx;
            ctx.OnUpdated += StateHasChanged;
        }
        else
        {
            _previousContext = null;
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        if (_previousContext is not null)
        {
            _previousContext.OnUpdated -= StateHasChanged;
        }
    }
}
