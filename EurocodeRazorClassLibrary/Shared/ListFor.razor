@typeparam TModel 
@using System.Reflection
@using CommonLibrary
@using ExportFactory.Services
@using ExportFactory.Shared

<div class="space-y-2">
    @foreach (var prop in TableColumnAttributeHelper.GetTableColumns<TModel>())
    {
        if (Item == null) continue;

        // filter op properties nader toe te voegen

        var info = TableColumnAttributeHelper.GetColumnInfo(prop, Item);

        // Formules bepalen
        var hasStatic = !string.IsNullOrWhiteSpace(info.Formula);
        var hasDynamic = !string.IsNullOrWhiteSpace(info.DynamicFormula);

        var hasFormula = info.Vergelijking != null;
        var tooltipIcon = info.Vergelijking?.Name ?? "?";

        @* Alleen tooltip renderen als er minstens één formule is *@
        if (hasStatic || hasDynamic || hasFormula)
        {
            <div class="table-grid"
                 style="display:grid; gap:.5rem; grid-template-columns:@GridTemplateColumns"
                 @key="prop.Name">

                @if (VisibleParts.HasFlag(ColumnPart.Header))
                {
                    <div class="header">@info.Header</div>
                }

                @if (VisibleParts.HasFlag(ColumnPart.Symbol))
                {
                    <div>@info.Symbol</div>
                }

                @if (VisibleParts.HasFlag(ColumnPart.Value))
                {
                    <div>@info.Value</div>
                }

                @if (VisibleParts.HasFlag(ColumnPart.Article))
                {
                    <div class="article">@info.Article</div>
                }

                @* Tooltip voor beide formules *@
                <div class="tooltip-container">
                    <span class="tooltip-icon">@tooltipIcon</span>
                    <div class="tooltip-content">
                        @if (hasStatic)
                        {
                            <div><strong>Statisch:</strong> <KaTexFormula Value="@info.Formula" /></div>

                        }
                        @if (hasDynamic)
                        {
                            <div><strong>Dynamisch:</strong> <KaTexFormula Value="@info.DynamicFormula" /></div>
                        }
                        @if (hasFormula)
                        {
                            tooltipIcon = info.Vergelijking?.Name;
                            
                            <div><strong>vgl. @info.Vergelijking?.Name:</strong> 
                                @if (info.Vergelijking?.StaticValue != null)
                                {
                                    <KaTexFormula Value="@info.Vergelijking?.StaticValue" />
                                    
                                }
                                @if(info.Vergelijking?.DynamicValue != null)
                                {
                                    <KaTexFormula Value="@info.Vergelijking?.DynamicValue" />
                                    
                                }
                                </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="table-grid"
                 style="display:grid; gap:.5rem; grid-template-columns:@GridTemplateColumns"
                 @key="prop.Name">

                @if (VisibleParts.HasFlag(ColumnPart.Header))
                {
                    <div class="header">@info.Header</div>
                }

                @if (VisibleParts.HasFlag(ColumnPart.Symbol))
                {
                    <div>@info.Symbol</div>
                }

                @if (VisibleParts.HasFlag(ColumnPart.Value))
                {
                    <div>@info.Value</div>
                }

                @if (VisibleParts.HasFlag(ColumnPart.Article))
                {
                    <div class="article">@info.Article</div>
                }
            </div>
        }
    }
</div>



