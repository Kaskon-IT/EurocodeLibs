@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<script>
       function copyRtfToClipboard(rtfContent) {
        const textarea = document.createElement("textarea");
        textarea.style.position = "fixed"; // Avoid scrolling to the bottom
        textarea.style.opacity = "0"; // Make it invisible
        textarea.value = rtfContent;
        document.body.appendChild(textarea);
        textarea.focus();
        textarea.select();

        try {
            const successful = document.execCommand("copy");
            console.log(successful ? "RTF content copied!" : "Failed to copy RTF content.");
        } catch (err) {
            console.error("Error copying RTF content:", err);
        }

        document.body.removeChild(textarea);
    }
</script>

<FluentButton OnClick="CopyRtf">Copy RTF</FluentButton>


@code {

    [Parameter]
    public string rtfContent { get; set; } = @"{\rtf1\ansi\deff0 {\fonttbl {\f0 Times New Roman;}} This is an \b example\b0.}";

    private async Task CopyRtf()
    {
        await JSRuntime.InvokeVoidAsync("copyRtfToClipboard", rtfContent);
    }
}
