@using ExportFactory.Services
@using ExportFactory.Extensions
@using System.Text
@using MigraDoc.Rendering
@using MigraDoc.RtfRendering


@typeparam T where T : class
@inject MigraDocCreator MigraDocCreator
@inject IJSRuntime JSRuntime

<lable>Exporteer</lable>
<FluentMenuButton @ref=menubutton ButtonAppearance="@Appearance.Accent" Text="Kies formaat" Items="@items" OnMenuChanged="HandleOnMenuChanged"></FluentMenuButton>




