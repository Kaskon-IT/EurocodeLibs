@using System.Text.RegularExpressions
@using System.Globalization
@inject ExportFactory.Services.DataTableMappingService MappingService
@inherits Custom.EurocodeComponentBase
@typeparam T where T : notnull


<div class="@GetContainerClass()">


    @if (LabelType == LabelType.Symbol)
    {
        <FluentTooltip Anchor="@GetTooltipId()">
            @GetTooltip()

        </FluentTooltip>
    }





    @if (LabelPosition == LabelPosition.Left)
    {
        @* <span id="@TooltipId" class="@GetLabelClass()">@GetLabel()</span> *@

        @if (LabelType == LabelType.SymbolAndDescription)
        {
            @* <span class="label-left">@GetLabel()</span> *@
            <span class="label-left label-long truncate-3">@GetDescription()</span>
            <span class="symbol-prefix truncate">@GetLabel()</span>
        }
    }




    @if (ReadOnly && 1 + 1 == 3)
    {
        // niet meer gebruiken, is duidelijker als niet gebruikt...
        <span style="width:70px; text-align:end;">@InputValue</span>
    }
    else
    {
        <div @onblur="OnBlurred">
            <FluentTextField Class="number-field"
                             @bind-Value="InputValue"
                             @oninput="ValidateInput"
                             @bind-MinValue="MinValue"
                             @bind-MaxValue="MaxValue"
                             Id="@Id"
                             Disabled=@Disabled
                             ReadOnly=@ReadOnly
                             Placeholder="Voer een getal in"
                             Size=12
                             Style="@style"
                             Appearance=@appearance
                             TextFieldType=TextFieldType.Text>
                @if (LabelPosition == LabelPosition.Top)
                {
                    <span class="truncate-1">@GetLabel(LabelType == LabelType.SymbolAndDescription) </span>
                }
            </FluentTextField>
        </div>

    }




    @if (LabelPosition == LabelPosition.Left)
    {
        <span class="unit-right">@Unit</span>
    }
    @if (LabelPosition == LabelPosition.Top)
    {
        <span class="unit-right unit-bottom">@Unit</span>
    }

</div>



<style>


    fluent-text-field::part(control) {
        text-align: left;
        /* Zodat de getallen RECHTS uitgelijnd worden zoals het hoort, Microsoft!!!! knuppels */
    }

    /* Specifiek voor numerieke invoer, rechts uitgelijnd */
    .number-field::part(control) {
        text-align: right;
        /* Omdat getallen RECHTS uitgelijnd horen te zijn */
    }



    .input-container {
        display: flex;
        /* flex-direction:row; */
        /* align-items: start; */
        margin-right: 5px;
        margin-bottom: 3px !important;
        margin-top: 3px !important;
        width: 100%;
    }

    /* Flex alignment opties */
    .align-start {
        align-items: flex-start; /* Uitlijnen aan de bovenkant */
    }

    .align-center {
        align-items: center; /* Centraal uitlijnen */
    }

    .align-end {
        align-items: flex-end; /* Uitlijnen aan de onderkant */
    }

    .align-baseline {
        align-items: baseline; /* Uitlijnen op de tekstbasislijn */
    }


    .row {
        flex-direction: row;
    }

    /* Eerste rij (bijvoorbeeld een header of titel) */
    .row-1 {
        background-color: lightblue; /* Ter illustratie */
    }

    /* Tweede rij (flex-column content) */
    .row-2 {
        display: flex;
        flex-direction: row; /* Zorgt dat de inhoud in een kolom wordt geplaatst */
        flex-grow: 1; /* Neemt alle beschikbare ruimte in */
        background-color: lightgreen; /* Ter illustratie */
    }


    .column {
        flex-direction: column;
    }

    .input-container FluentTextField {
        flex-grow: 1;
    }

    .input-container span {
        margin-bottom: 0.425em; /* Zorgt voor uitlijning als het label boven de input staat */
        margin-top: 0.425em; /* Zorgt voor uitlijning als het label voor de input staat */
        margin-left: 0.25em;
        margin-right: 0.25em;
        /* font-family: 'Cambria Math'; */
        /* font-size: smaller; */
        /* font-style: italic; */
        /* color: gray !important;  */
        /* Pas de kleur aan indien minder opzichtig gewenst is */
    }

    /* Standaard: Unit rechts van het invoerveld */
    .input-container .unit-right {
        margin-left: 5px; /* Ruimte tussen input en eenheid */
        margin-right: 5px;
        /* font-size: smaller; */
        width: 50px;
        /* color: gray !important; */
    }

    .input-container .unit-bottom {
        align-items: baseline;
    }

    /* Unit links van het invoerveld */
    .input-container .label-left {
        margin-right: 5px; /* Ruimte tussen eenheid en input */
        min-width: 50px;
        /* color: darkblue !important; */
    }

    .input-container .label-long {
        width: calc(100% - 300px); /* 100% breedte min 50px */
        flex-shrink: 0; /* Voorkomt dat het veld kleiner wordt */
        /* color: darkgreen !important; */
    }

    .input-container .symbol-prefix {
        min-width: 60px; /* Genoeg ruimte voor A~sw,min~ = */
        text-align: right;
    }

    .input-container .truncate {
        white-space: nowrap; /* Voorkomt dat de tekst wordt afgebroken */
        max-width: 100%;
        overflow: hidden; /* Verbergt de overtollige tekst */
        text-overflow: ellipsis; /* Toont '...' als de tekst te lang is */
    }

    .input-container .truncate-1 {
        display: -webkit-box;
        -webkit-line-clamp: 2; /* Maximaal aantal regels */
        -webkit-box-orient: vertical;
        overflow: hidden; /* Verbergt de rest van de tekst */
    }

    .input-container .truncate-2 {
        display: -webkit-box;
        line-height: 1.3;
        -webkit-line-clamp: 2; /* Maximaal aantal regels */
        -webkit-box-orient: vertical;
        overflow: hidden; /* Verbergt de rest van de tekst */
    }

    .input-container .truncate-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3; /* Maximaal aantal regels */
        -webkit-box-orient: vertical;
        overflow: hidden; /* Verbergt de rest van de tekst */
        /* font-size: clamp(6px, 1vw, 14px); /* Krimpt naar 4% van de viewport of 16px */
        line-height: 1.3; /* Regelafstand */
    }

</style>


@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div style="width: 100%; color: var(--warning); text-align: center; font-weight:600; background-color:transparent; border-radius: 6px; margin: 8px 8px 8px 8px; padding: 2px; border:1px dotted red">@((MarkupString)ErrorMessage)</div>
}

@code {
    [Parameter, EditorRequired] public T? Value { get; set; } // Kan int, double of decimal zijn
    [Parameter, EditorRequired] public string Key { get; set; } = string.Empty;
    [Parameter] public LabelPosition LabelPosition { get; set; } = LabelPosition.Left;
    [Parameter] public LabelType LabelType { get; set; } = LabelType.SymbolAndDescription;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool ReadOnly { get; set; } = false;
    [Parameter] public RenderFragment? TooltipContent { get; set; }
    [Parameter] public EventCallback<T?> ValueChanged { get; set; } // Terugkoppeling van waarde
    [Parameter] public double MinValue { get; set; } = double.MinValue;
    [Parameter] public double MaxValue { get; set; } = double.MaxValue;
    [Parameter] public string Description { get; set; } = string.Empty; // Omschrijving
    [Parameter] public string Label { get; set; } = string.Empty; // Label voor het invoerveld
    [Parameter] public string Unit { get; set; } = string.Empty; // Suffix
    [Parameter] public string? Id { get; set; } = Guid.NewGuid().ToString(); // Standaard unieke Id


    private string? TooltipId { get; set; } = Guid.NewGuid().ToString();
    private FluentInputAppearance appearance => ReadOnly ? FluentInputAppearance.Filled : FluentInputAppearance.Outline;
    private string style => (LabelPosition == LabelPosition.Top && LabelType == LabelType.SymbolAndDescription) ? "width:calc(100% - 100px);" : "max-width:100px;";
    private string InputValue { get; set; } = string.Empty;
    private string? ErrorMessage { get; set; }
    private bool IsFocused { get; set; } = false;

    private bool IsOneindigDebugTest
    {
        get
        {
            return (!String.IsNullOrEmpty(InputValue) && InputValue == "∞");
        }
    }

    private async Task OnBlurred(FocusEventArgs e)
    {
        Console.WriteLine($"TextField is verlaten (@onblur) ({Label})");
        await NotifyParentAsync();
    }




    private string? GetTooltipId() =>
        LabelPosition switch
        {
            LabelPosition.Left => TooltipId,
            LabelPosition.Top => Id,
            _ => TooltipId
        };


    private string GetLabelClass() =>
        LabelType == LabelType.SymbolAndDescription ? "label-left label-longX truncateX" : "label-left";

    private string GetContainerClass() =>
        LabelPosition == LabelPosition.Top ? "input-container align-end" : "input-container align-start";



    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Value == null) return;

        if (Value is string debugString)
        {
            if (debugString == "∞")
            {
                //
                string foutmelding = "Er gaat iets niet goed";
                Console.WriteLine("T? is een string");
            }
        }
        else
        {
            InputValue = FormatValue(Value);
        }




        //MappingService.Data.
        //var mappingService = new ExportFactory.Services.DataTableMappingService();
        //var mappingDict = mappingService.GetEurocodeMapping();

        MappingService.Data.TryGetValue(Key, out var mapping);
        Mapping = mapping;
    }

    // Detecteer wijzigingen in de parent (bij gebruik Value="")
    protected override void OnParametersSet()
    {
        if (Value == null) return;

        if (InputValue == "∞")
        {
            string foutmelding = "Er gaat iets niet goed";
        }

        if (Value is string debugString)
        {
            if (debugString == "∞")
            {
                //
                string foutmelding = "Er gaat iets niet goed";
            }
        }



        // Alleen bij Value="" en niet bij @bind-Value
        if (ValueChanged.HasDelegate == false && Value is not null)
        {
            InputValue = FormatValue(Value);
            ValidateMinMax(new ChangeEventArgs { Value = InputValue });
            //ForceValidation(); // Check opnieuw bij elke parameterwijziging
        }
        else
        {
            // mogelijk is de min of max gewijzigd (door aanpassen andere parameter)
            //Console.WriteLine($"{Key} min ={MinValue} | max = {MaxValue} gaan we valideren.");
            ValidateMinMax(new ChangeEventArgs { Value = InputValue });
            //ForceValidation();
            //ForceValidation(); // Check opnieuw bij elke parameterwijziging

            if (Value is not null)
                InputValue = FormatValue(Value); // waarom stond dit uit?
            // Dit staat uit omdat anders de input niet meer goed werkt (backspace en dergelijke)!;
            // zoek uit welke input dit is!
        }
    }


    private async Task ForceValidation()
    {
        ValidateMinMax(new ChangeEventArgs { Value = InputValue });
        //await ValidateInput(new ChangeEventArgs { Value = InputValue });

    }

    private async Task ValidateInput(ChangeEventArgs e)
    {
        InputValue = e.Value?.ToString() ?? string.Empty;

        // Regex voor numerieke input inclusief wetenschappelijke notatie
        var isValid = Regex.IsMatch(InputValue, @"^-?\d+([.,]\d+)?([eE][-+]?\d+)?([.,]?)$");

        if (!isValid)
        {
            ErrorMessage = "⚠️ Ongeldige invoer: gebruik een getal of wetenschappelijke notatie.";
            return;
        }

        var normalizedInput = InputValue.Replace(",", ".");

        try
        {
            if (TryParseValue(normalizedInput, out T? newValue))
            {
                if (!normalizedInput.EndsWith('.'))
                {
                    await SetValueAsync(newValue);
                    Console.WriteLine("Gaat hier nu iets gebeuren");
                    await NotifyParentAsync();
                }


            }
            else
            {
                ErrorMessage = "⚠️ Ongeldig type.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"⚠️ Fout bij invoer: {ex.Message}";
        }
    }

    private string GetMinValueString => MinValue > double.MinValue ? MinValue.ToString("0.##") : string.Empty;
    private string GetMaxValueString => MaxValue < double.MaxValue ? MaxValue.ToString("0.##") : string.Empty;


    private void ValidateMinMax(string strValue)
    {
        if (strValue == "∞" || strValue == "-∞")
        {
            return;
        }

        var normalizedInput = InputValue.Replace(",", ".");
        // Probeer te casten naar double voor validatie
        if (normalizedInput is IConvertible convertible)
        {
            var doubleValue = convertible.ToDouble(CultureInfo.InvariantCulture);

            if (doubleValue < MinValue || doubleValue > MaxValue)
            {
                if (!string.IsNullOrEmpty(GetMinValueString) && !string.IsNullOrEmpty(GetMaxValueString))
                {
                    ErrorMessage = $"⚠️ Waarde {GetDescription()} {GetLabel()} moet tussen {GetMinValueString} en {GetMaxValueString} {Unit} liggen.";
                }
                else if (!string.IsNullOrEmpty(GetMinValueString))
                {
                    ErrorMessage = $"⚠️ Minimum waarde {GetDescription()} {GetLabel()} is {GetMinValueString} {Unit}.";
                }
                else if (!string.IsNullOrEmpty(GetMaxValueString))
                {
                    ErrorMessage = $"⚠️ Maximum waarde {GetDescription()} {GetLabel()} is {GetMaxValueString} {Unit}.";
                }
            }
            else
            {
                ErrorMessage = null;
            }
        }
    }


    private void ValidateMinMax(ChangeEventArgs e)
    {
        if (e.Value is string value)
        {
            ValidateMinMax(value);
        }
    }

    private async Task SetValueAsync(T? newValue)
    {
        ErrorMessage = null;
        if (newValue is IConvertible convertible)
        {


            var doubleValue = convertible.ToDouble(CultureInfo.InvariantCulture);



            if (doubleValue < MinValue || doubleValue > MaxValue)
            {
                if (!string.IsNullOrEmpty(GetMinValueString) && !string.IsNullOrEmpty(GetMaxValueString))
                {
                    ErrorMessage = $"⚠️ Waarde {GetLabel()} moet tussen {GetMinValueString} en {GetMaxValueString} {Unit} liggen.";

                }
                else if (!string.IsNullOrEmpty(GetMinValueString))
                {
                    ErrorMessage = $"⚠️ Minimum waarde {GetLabel()} is {GetMinValueString} {Unit}.";
                }
                else if (!string.IsNullOrEmpty(GetMaxValueString))
                {
                    ErrorMessage = $"⚠️ Maximum waarde {GetLabel()} is {GetMaxValueString} {Unit}.";
                }
            }
        }

        Value = newValue;
        await ValueChanged.InvokeAsync(newValue);
        //await InvokeAsync(StateHasChanged).ConfigureAwait(false); // Forceert UI-verversing
    }

    private bool TryParseValue(string input, out T? value)
    {
        value = default;

        if (typeof(T) == typeof(int) && int.TryParse(input, NumberStyles.Float, CultureInfo.InvariantCulture, out var intValue))
        {
            value = (T)(object)intValue;
            return true;
        }

        if (typeof(T) == typeof(double) && double.TryParse(input, NumberStyles.Float, CultureInfo.InvariantCulture, out var doubleValue))
        {
            value = (T)(object)doubleValue;
            return true;
        }

        if (typeof(T) == typeof(decimal) && decimal.TryParse(input, NumberStyles.Float, CultureInfo.InvariantCulture, out var decimalValue))
        {
            value = (T)(object)decimalValue;
            return true;
        }

        return false;
    }

    [Parameter] public string StringFormat { get; set; } = "0.##";

    private string FormatValue(T value) => value is not null && double.TryParse(value.ToString(), out var number) ? FormatNumber(number) : string.Empty;

    // Hulpmethode om getallen te formatteren
    private string FormatNumber(double number)
    {
        // Als het getal buiten het bereik ligt, gebruik wetenschappelijke notatie
        if (number != 0 && (Math.Abs(number) >= 1000000 || Math.Abs(number) < 0.001))
        {
            return number.ToString("0.#####E+0", CultureInfo.InvariantCulture); // Wetenschappelijke notatie met max 5 significante cijfers
        }

        // Anders gebruik het standaardformaat
        return number.ToString(StringFormat, CultureInfo.InvariantCulture);
    }



    private string DisplayValue
    {
        get
        {
            if (IsFocused)
            {
                return InputValue; // Alleen de waarde zonder eenheid tonen als het veld gefocust is
            }
            return $"{InputValue} {Unit}".Trim(); // Voeg de eenheid toe als het veld niet gefocust is
        }

    }


    public MarkupString GetMarkupString(string markup, bool makeItalic = false)
    {
        string html = ExportFactory.Services.HtmlCreator.MarkdownToHtml(markup);

        if (makeItalic)
        {
            html = $"<i>{html}</i>";
        }

        return (MarkupString)html;
    }


    private ExportFactory.Shared.AttributesMapping? Mapping { get; set; }



    public MarkupString? GetLabel(bool withDescription = false)
    {

        if (Mapping == null)
        {
            return GetMarkupString(Label, true);
        }

        string markup = $"{Key}";
        if (Mapping != null)
        {
            markup = $"{Mapping.Symbol}";
            if (withDescription)
            {
                markup += $" {Mapping.Description}";
            }
        }
        if (string.IsNullOrWhiteSpace(markup)) return null;
        return GetMarkupString(markup, true);
    }

    public MarkupString? GetDescription()
    {
        if (Mapping == null)
        {
            return GetMarkupString(Description, false);
        }


        string markup = "";
        if (Mapping != null && Mapping.Description != null)
        {
            markup = $"{Mapping.Description}";
        }
        return GetMarkupString(markup, false);
    }


    public MarkupString? GetTooltip()
    {
        //var mapping = ExportFactory.Extensions.DataTableExtensions.EurocodeMapping[key];

        if (Mapping != null)
        {
            string markup = $"{Mapping.Symbol} = {Mapping.Description}";
            if (Mapping.Referentie != null)
                markup += $" {Mapping.Referentie}";

            return GetMarkupString(markup, true);
        }
        else return null;

    }




}

