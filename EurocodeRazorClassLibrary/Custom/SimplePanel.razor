@implements IDialogContentComponent<string>
@using Microsoft.FluentUI.AspNetCore.Components
@inject IJSRuntime JS;



<FluentDialogBody>

    <!-- Render the raw HTML string here using MarkupString -->
    <div>@((MarkupString)Content)</div>


    

   
</FluentDialogBody>

@code {
    [Parameter]
    public string Content { get; set; } = default!;


    private async Task ToggleAccordion(string accordionId)
    {
        await JS.InvokeVoidAsync("toggleAccordion", accordionId);
    }

    

}
