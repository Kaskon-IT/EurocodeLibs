@using Microsoft.FluentUI.AspNetCore.Components.Extensions
@typeparam TEnum where TEnum : struct, Enum

@if(LabelPosition == LabelPosition.Left)
{
    <div style="display: flex; align-items: center; width: 100%;">
        <div style="
                width: 200px;
                display: -webkit-box;
                margin-left:3.5px;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;">
            @Label
        </div>

        <FluentSelect TOption="Option<int>"
            Items="_enumOptions"
            OptionText="@(i => i.Text)"
            OptionValue="@(i => i.Value.ToString())"
            OptionDisabled="@(i => i.Disabled)"
            OptionSelected="@(i => i.Selected)"
            @bind-Value="_selectedValue"
            @bind-SelectedOption=_selectedIntOption
            Placeholder="@Placeholder"
            AdditionalAttributes="@AdditionalAttributes"
            Disabled="@DisabledOrReadOnly"
            ReadOnly="@ReadOnly"
            Style="flex: 1;"
            Multiple="@Multiple" />
    </div>
}
else if(LabelPosition == LabelPosition.Top)
{
    <FluentSelect TOption="Option<int>"
        Items="_enumOptions"
        Label="@Label"
        OptionText="@(i => i.Text)"
        OptionValue="@(i => i.Value.ToString())"
        OptionDisabled="@(i => i.Disabled)"
        OptionSelected="@(i => i.Selected)"
        @bind-Value="_selectedValue"
        @bind-SelectedOption=_selectedIntOption
        Placeholder="@Placeholder"
        AdditionalAttributes="@AdditionalAttributes"
        Disabled="@DisabledOrReadOnly"
        ReadOnly="@ReadOnly" 
        Width="@Width"
        Style="@Style"
        Multiple="@Multiple" />
}

@code {
    [Parameter] public LabelPosition LabelPosition { get; set; } = LabelPosition.Top;
    [Parameter] public TEnum EnumSelectedValue { get; set; }
    [Parameter] public EventCallback<TEnum> EnumSelectedValueChanged { get; set; }
    [Parameter] public EventCallback OnStateChanged { get; set; }
    [Parameter] public TEnum[] ExcludeEnumItems { get; set; } = [];
    [Parameter] public TEnum[] DisabledEnumItems { get; set; } = [];
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> AdditionalAttributes { get; set; } = new();
    [Parameter] public bool ShowDescription { get; set; } = true;
    private bool Multiple = false;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool ReadOnly { get; set; } = false;
    [Parameter] public string? Width { get; set; } = null;
    [Parameter] public string? Style { get; set; } = "width: 100%; max-height: 200px;";

    private bool DisabledOrReadOnly => Disabled || ReadOnly;

    private Option<int> _selectedIntOption { get; set; } = new();
    private List<Option<int>> _enumOptions = [];
    private string _selectedValue
    {
        get => _enumOptions.FirstOrDefault(e => e.Value == GetEnumInt(EnumSelectedValue))?.Value.ToString() ?? "0";
        set
        {
            if (value is null || !Enum.TryParse<TEnum>(value, out var result)) return;
            EnumSelectedValue = result;
            EnumSelectedValueChanged.InvokeAsync(result);
            OnStateChanged.InvokeAsync();
        }
    }

    protected override void OnInitialized()
    {
        if (!typeof(TEnum).IsEnum)
            throw new InvalidOperationException($"{typeof(TEnum).Name} is not an enum type");
    }

    protected override void OnParametersSet()
    {
        _enumOptions = Enum.GetValues(typeof(TEnum))
           .Cast<TEnum>()
           .Where(e => !ExcludeEnumItems.Contains(e))
           .Select(e => new Option<int>
           {
               Value = GetEnumInt(e),
               Text = ShowDescription ? e.GetDescription(false) : e.ToString(),
               Selected = e.Equals(EnumSelectedValue),
               Disabled = DisabledEnumItems.Contains(e),
           })
           .ToList();
    }

    private static int GetEnumInt(TEnum value)
    {
        return (int)Convert.ChangeType(value, typeof(int));
    }
}
