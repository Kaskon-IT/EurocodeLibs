@inject IDialogService DialogService
@using Microsoft.FluentUI.AspNetCore.Components

<FluentButton @onclick="@OpenPanelRightAsync" Appearance="Appearance.Accent">
    Preview (Weblayout)
</FluentButton>






@code{
    [Parameter] 
    public string HtmlContent { get; set; } = default!;

    [Parameter] 
    public EventCallback OnGenerateNewHtmlContent { get; set; }

    private async void HandleGenerateNewHtmlContent()
    {
        // Notify the parent to regenerate the document
        await OnGenerateNewHtmlContent.InvokeAsync();

        await Task.Delay(200);

        StateHasChanged();
    }



    private IDialogReference? _dialog;


    private async Task OpenPanelRightAsync()
    {
        // first send message to parent to get an updated content
        HandleGenerateNewHtmlContent();

        // snap er niks van
        await Task.Delay(200);

       

        _dialog = await DialogService.ShowPanelAsync<SimplePanel>(HtmlContent, new DialogParameters<string>()
            {
                Content = HtmlContent,
                Alignment = HorizontalAlignment.Right,
                Title = $"Document Preview",
                ShowTitle = true,
                PrimaryAction = null,
                SecondaryAction = null,
                Width = "90%",
                Height = "100%"
            });
        DialogResult result = await _dialog.Result;
        HandlePanel(result);

    }

    private static void HandlePanel(DialogResult result)
    {
        if (result.Cancelled)
        {
            return;
        }

        


        if (result.Data is not null)
        {
            if (result.Data is string str)
            {
                
            }

            return;
        }
    }
}