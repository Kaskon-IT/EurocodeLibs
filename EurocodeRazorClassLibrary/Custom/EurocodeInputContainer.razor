@using System.Text.RegularExpressions
@using System.Globalization
@inject ExportFactory.Services.DataTableMappingService MappingService


<div class="@GetContainerClass()">


    @if(LabelType == LabelType.Symbol)
    {
        <FluentTooltip Anchor="@GetTooltipId()">
            @GetTooltip()

        </FluentTooltip>
    }



    @if(LabelPosition == LabelPosition.Left)
    {
        @* <span id="@TooltipId" class="@GetLabelClass()">@GetLabel()</span> *@

        @if(LabelType == LabelType.SymbolAndDescription)
        {
            @* <span class="label-left">@GetLabel()</span> *@
            <span class="label-left label-long truncate-3">@GetDescription()</span>
            <span class="symbol-prefix truncate">@GetLabel() =</span>
        }
    }

    <div style="width:100px; align-items:center">
        @ChildContent
    </div>



    @if (LabelPosition == LabelPosition.Left)
    {
        <span class="unit-right">@Unit</span>
    }
    @if (LabelPosition == LabelPosition.Top)
    {
        <span class="unit-right unit-bottom">@Unit</span>
    }

</div>



<style>


    fluent-text-field::part(control) {
    text-align: left;
    /* Zodat de getallen RECHTS uitgelijnd worden zoals het hoort, Microsoft!!!! knuppels */
    }


    .input-containerXX {
        display: flex;
        align-items: center; /* verticaal centreren */
        gap: 4px; /* optioneel ruimte ertussen */
    }


    .input-container {
    display: flex;
    align-items: center; /* verticaal centreren */
    gap: 4px; /* optioneel ruimte ertussen */
    /* flex-direction:row; */
    /* align-items: start; */
    margin-right: 5px;
    margin-bottom: 3px !important;
    margin-top: 3px !important;
    width: 100%;
    }

    /* Flex alignment opties */
    .align-start {
    align-items: flex-start; /* Uitlijnen aan de bovenkant */
    }

    .align-center {
    align-items: center; /* Centraal uitlijnen */
    }

    .align-end {
    align-items: flex-end; /* Uitlijnen aan de onderkant */
    }

    .align-baseline {
    align-items: baseline; /* Uitlijnen op de tekstbasislijn */
    }


    .row{
    flex-direction:row;
    }

    /* Eerste rij (bijvoorbeeld een header of titel) */
    .row-1 {
    background-color: lightblue; /* Ter illustratie */
    }

    /* Tweede rij (flex-column content) */
    .row-2 {
    display: flex;
    flex-direction: row; /* Zorgt dat de inhoud in een kolom wordt geplaatst */
    flex-grow: 1; /* Neemt alle beschikbare ruimte in */
    background-color: lightgreen; /* Ter illustratie */
    }


    .column{
    flex-direction:column;
    }

    .input-container FluentTextField {
    flex-grow: 1;
    }

    .input-container span {
    margin-bottom: 0.425em; /* Zorgt voor uitlijning als het label boven de input staat */
    margin-top: 0.425em; /* Zorgt voor uitlijning als het label voor de input staat */
    margin-left: 0.25em;
    margin-right: 0.25em;
    /* font-family: 'Cambria Math'; */
    /* font-size: smaller; */
    /* font-style: italic; */
    /* color: gray !important;  */
    /* Pas de kleur aan indien minder opzichtig gewenst is */
    }

    /* Standaard: Unit rechts van het invoerveld */
    .input-container .unit-right {
    margin-left: 5px; /* Ruimte tussen input en eenheid */
    margin-right: 5px;
    /* font-size: smaller; */
    width: 50px;
    /* color: gray !important; */
    }

    .input-container .unit-bottom{
    align-items: baseline;
    }

    /* Unit links van het invoerveld */
    .input-container .label-left {
    margin-right: 5px; /* Ruimte tussen eenheid en input */
    min-width: 50px;
    /* color: darkblue !important; */
    }

    .input-container .label-long{
    width: calc(100% - 300px); /* 100% breedte min 50px */
    flex-shrink: 0; /* Voorkomt dat het veld kleiner wordt */
    /* color: darkgreen !important; */
    }

    .input-container .symbol-prefix{
    min-width: 60px; /* Genoeg ruimte voor A~sw,min~ = */
    text-align: right;
    }

    .input-container .truncate {
    white-space: nowrap; /* Voorkomt dat de tekst wordt afgebroken */
    max-width: 100%;
    overflow: hidden; /* Verbergt de overtollige tekst */
    text-overflow: ellipsis; /* Toont '...' als de tekst te lang is */
    }

    .input-container .truncate-1 {

    display: -webkit-box;
    -webkit-line-clamp: 2; /* Maximaal aantal regels */
    -webkit-box-orient: vertical;
    overflow: hidden; /* Verbergt de rest van de tekst */
    }

    .input-container .truncate-2 {
    display: -webkit-box;
    line-height:1.3; 
    -webkit-line-clamp: 2; /* Maximaal aantal regels */
    -webkit-box-orient: vertical;
    overflow: hidden; /* Verbergt de rest van de tekst */
    }

    .input-container .truncate-3 {
    display: -webkit-box;

    -webkit-line-clamp: 3; /* Maximaal aantal regels */
    -webkit-box-orient: vertical;
    overflow: hidden; /* Verbergt de rest van de tekst */

    /* font-size: clamp(6px, 1vw, 14px); /* Krimpt naar 4% van de viewport of 16px */ */
    line-height: 1.3; /* Regelafstand */
    }



</style>


@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div style="color: var(--warning); text-align: center; font-weight:600; background-color:transparent; border-radius: 6px; margin: 8px 8px 8px 8px; padding: 2px; border:1px dotted red">@((MarkupString)ErrorMessage)</div>
}

@code {


    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter, EditorRequired]
    public string Key { get; set; } = string.Empty;

    [Parameter]
    public LabelPosition LabelPosition { get; set; } = LabelPosition.Left;

    [Parameter]
    public LabelType LabelType { get; set; } = LabelType.SymbolAndDescription;



    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public bool ReadOnly { get; set; } = false;


    [Parameter]
    public RenderFragment? TooltipContent { get; set; }




    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Unit { get; set; } = string.Empty;

    [Parameter]
    public string? Id { get; set; } = Guid.NewGuid().ToString(); // Standaard unieke Id

    private string? TooltipId { get; set; } = Guid.NewGuid().ToString();

    private FluentInputAppearance appearance => ReadOnly ? FluentInputAppearance.Filled : FluentInputAppearance.Outline;

    private string style => (  LabelPosition == LabelPosition.Top && LabelType == LabelType.SymbolAndDescription) ? "width:calc(100% - 100px);" : "max-width:100px;";

    //[Parameter]
    //public string Tooltip { get; set; } = string.Empty;

    private string InputValue { get; set; } = string.Empty;
    private string? ErrorMessage { get; set; }
    private bool IsFocused { get; set; } = false;




    private string? GetTooltipId() =>
        LabelPosition switch
        {
            LabelPosition.Left => TooltipId, 
            LabelPosition.Top => Id, 
            _ => TooltipId
        };


    private string GetLabelClass() =>
        LabelType == LabelType.SymbolAndDescription ? "label-left label-longX truncateX" : "label-left";

    private string GetContainerClass() =>
        LabelPosition == LabelPosition.Top ? "input-container align-end" : "input-container align-startX";



    protected override void OnInitialized()
    {
        MappingService.Data.TryGetValue(Key, out var mapping);
        Mapping = mapping;
    }

    // Detecteer wijzigingen in de parent (bij gebruik Value="")
    protected override void OnParametersSet()
    {

    }








    public MarkupString GetMarkupString(string markup, bool makeItalic = false)
    {
        string html = ExportFactory.Services.HtmlCreator.MarkdownToHtml(markup);

        if (makeItalic)
        {
            html = $"<i>{html}</i>";
        }

        return (MarkupString)html;
    }


    private ExportFactory.Shared.AttributesMapping? Mapping{ get; set; } 



    public MarkupString? GetLabel(bool withDescription = false)
    {
        string markup = $"{Key}";
        if (Mapping != null)
        {
            markup = $"{Mapping.Symbol}";
            if (withDescription)
            {
                markup += $" {Mapping.Description}";
            }
        }
        if (string.IsNullOrWhiteSpace(markup))
            return null;
        return GetMarkupString(markup, true);
    }

    public MarkupString? GetDescription()
    {
        string markup = "";
        if (Mapping != null && Mapping.Description != null)
        {
            markup = $"{Mapping.Description}";
        }
        if (string.IsNullOrWhiteSpace(markup))
            return null;
        return GetMarkupString(markup, false);
    }


    public MarkupString? GetTooltip()
    {
        //var mapping = ExportFactory.Extensions.DataTableExtensions.EurocodeMapping[key];
        
        if (Mapping != null)
        {
            string markup = $"{Mapping.Symbol} = {Mapping.Description}";
            if (Mapping.Referentie != null)
                markup += $" {Mapping.Referentie}";

            return GetMarkupString(markup, true);
        }
        else return null;

    }




}

