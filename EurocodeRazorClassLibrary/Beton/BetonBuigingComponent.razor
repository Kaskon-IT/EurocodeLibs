@code {
    // volgens mij hebben we 1 context nodig met nested contexts
    private ZuivereBuiging ZuivereBuigingInstance = new ZuivereBuiging();

    private SectionForces forces = new() { My = 100};
    private BetonContext betonContext = new BetonContext();
    private WapeningContext wapeningContext = new WapeningContext();
    private ParametrischeProfielen.ParametrischProfielContext profiel = new();

    protected override void OnInitialized()
    {
        ZuivereBuigingInstance.Beton = betonContext;
        ZuivereBuigingInstance.Wapening = wapeningContext;
        ZuivereBuigingInstance.Profiel = profiel;
        ZuivereBuigingInstance.DekkingToegepast = 30;
        ZuivereBuigingInstance.Forces = forces;

        ZuivereBuigingInstance.Init();
