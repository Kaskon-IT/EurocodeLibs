@using Eurocode.BetonConstructies
@using Eurocode.BetonConstructies.SpecifiekeRegels
@using K = CommonLibrary.EurocodeKeys

@inject Services.ReadOnlyService ReadOnlyService

@* <BaseEurocodeContextComponent Model="Model"></BaseEurocodeContextComponent> *@


beton:@Model.Beton.ToString()


<p>@Model.ToMarkupString()</p>


<FluentGrid Spacing="4">
    <FluentGridItem xs="12">
        <EurocodeInputNumber ReadOnly=true Value="Model.Ved" Key="@K.DwarskrachtRekenwaarde" Unit="kN" MinValue=-Model.DwarskrachtWeerstandMax MaxValue="@Model.DwarskrachtWeerstandMax"></EurocodeInputNumber>
        <EurocodeInputNumber ReadOnly=ReadOnlyService.IsFieldReadOnly(nameof(Model.Profiel.Breedte)) @bind-Value="Model.Profiel.Breedte" Key="Breedte" MinValue=60 Unit="mm"></EurocodeInputNumber>
        <EurocodeInputNumber ReadOnly=ReadOnlyService.IsFieldReadOnly(nameof(Model.NutHoogte)) @bind-Value="Model.NutHoogte" Key="NutHoogte" MinValue=30 Unit="mm"></EurocodeInputNumber>
        <EurocodeInputNumber ReadOnly=ReadOnlyService.IsFieldReadOnly(nameof(Model.AsLangs)) @bind-Value="Model.AsLangs" MinValue=0 Key="AsLangs" MaxValue="@Balken.GetAsMax(Model.Profiel)" Unit="mm²"></EurocodeInputNumber>
        <EurocodeInputNumber ReadOnly=ReadOnlyService.IsFieldReadOnly(nameof(Model.Theta)) @bind-Value="Model.Theta" Key="Theta" Unit="°" MinValue=21.8 MaxValue=45></EurocodeInputNumber>
        <EurocodeInputNumber ReadOnly=ReadOnlyService.IsFieldReadOnly(nameof(Model.Alpha)) @bind-Value="Model.Alpha" Key="Alpha" Unit="°" MinValue=@Balken.GetGrenswaardeHoekDwarskrachtWapening().min MaxValue=@Balken.GetGrenswaardeHoekDwarskrachtWapening().max></EurocodeInputNumber>
    </FluentGridItem>

    <FluentGridItem xs="12">
        <EurocodeInputNumber ReadOnly=true Value="Model.Z" Key="Z" Unit="mm"></EurocodeInputNumber>

        <EurocodeInputNumber ReadOnly=true Value="Model.AswBerekend" Key="AswBerekend" Unit="mm²/m¹" StringFormat="0"></EurocodeInputNumber>
        <EurocodeInputNumber ReadOnly=true Value="Model.AswMin" Key="AswMin" Unit="mm²/m¹" StringFormat="0"></EurocodeInputNumber>
        <EurocodeInputNumber ReadOnly=true Value="Model.AswBenPerMeter" Key="AswBenPerMeter" Unit="mm²/m¹" StringFormat="0"></EurocodeInputNumber>
        <EurocodeInputNumber ReadOnly=true Value="Model.AswToegepast" Key="AswToegepast" Unit="mm²/m¹" StringFormat="0"></EurocodeInputNumber>
    </FluentGridItem>

    <FluentGridItem xs="12">
        <EurocodeInputNumber ReadOnly=true Value="Model.DwarskrachtWeerstand" Key="DwarskrachtWeerstand" Unit="kN" StringFormat="0.0"></EurocodeInputNumber>
        <EurocodeInputNumber ReadOnly=true Value="Model.DwarskrachtWeerstandBeton" Key="DwarskrachtWeerstandBeton" Unit="kN" StringFormat="0.0"></EurocodeInputNumber>
        <EurocodeInputNumber ReadOnly=true Value="Model.DwarskrachtWeerstandMax" Key="DwarskrachtWeerstandMax" Unit="kN" StringFormat="0.0"></EurocodeInputNumber>
    </FluentGridItem>

    <FluentGridItem xs="12">
        <EurocodeInputNumber ReadOnly=true Value="Model.SchuifspanningD" Key="SchuifspanningD" Unit="MPa" StringFormat="0.##"></EurocodeInputNumber>
        <EurocodeInputNumber ReadOnly=true Value="Model.SchuifspanningWeerstandBeton" Key="SchuifspanningWeerstandBeton" Unit="MPa" StringFormat="0.##"></EurocodeInputNumber>
        @* <EurocodeInputNumber ReadOnly=true Value="Model.DwarskrachtWeerstandMax" Key="DwarskrachtWeerstandMax" Unit="MPa" StringFormat="0.0"></EurocodeInputNumber> *@
    </FluentGridItem>




</FluentGrid>




@code {
    /// <summary>
    /// Het model 
    /// </summary>
    [Parameter, EditorRequired]
    public required DwarskrachtWapContext Model { get; set; }



    //[Parameter]
    //public BetonContext Beton { get; set; } = new();

    [Parameter]
    public ParametrischeProfielen.ParametrischProfielContext Profiel { get; set; } = new();


    [Parameter]
    public Dictionary<string, bool> ReadOnlyFields { get; set; } = new()
    {
        { "Theta", !true}, {"Alpha", !true}
    };




    /// <summary>
    /// Callback is nodig voor @bind-Model
    /// </summary>
    [Parameter]
    public EventCallback<DwarskrachtWapContext> ModelChanged { get; set; }

    protected override void OnInitialized()
    {
        ReadOnlyService.SetReadOnlyFields(this.ReadOnlyFields);
        //Model = new(Beton, Profiel, 100);
        //Model = DwarskrachtWap.GetDwarskrachtWapContext(Beton, Profiel, 21.8, 350, 0.9 * 350, 100, 2, 8, [100.0, 200.0, 300.0]);

    }

    //string symVed = ExportFactory.Services.HtmlCreator.MarkdownToHtml("V~Ed~");
    //string symTheta = ExportFactory.Services.HtmlCreator.MarkdownToHtml("|theta|");



}
