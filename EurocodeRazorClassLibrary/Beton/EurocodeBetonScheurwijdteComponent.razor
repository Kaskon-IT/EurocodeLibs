@using Eurocode.BetonConstructies
@using K = CommonLibrary.EurocodeKeys
@using System.ComponentModel

@* <EurocodeRefreshButton Model="@Model" OnUpdated="@OnUpdated" /> *@

@* <BaseEurocodeContextComponent Model="Model"></BaseEurocodeContextComponent> *@


@if(Model != null)
{
    


@* <p>@Model.ToMarkupString()</p> *@

<div>
    @* beton : @Model.Beton.ToMarkupString() <br /> *@
    @* dekking : @Model.Dekking.ToMarkupString() <br /> *@
    <h5>Scheurwijdte</h5>
    @* grenswaarde: @Model.ScheurwijdteGrenswaarde.ToMarkupString() <br /> *@

</div>







@* <EurocodeInputContainer Key="Wapening">
    <FluentTextField @bind-Value="Model.Wapening.Tekst"></FluentTextField>
</EurocodeInputContainer> *@

@* <EurocodeInputNumber ReadOnly=true Value=Model.AsToe Key="@K.AsToe" Unit="mm²" ></EurocodeInputNumber> *@

@* <EurocodeInputNumber ReadOnly=true Value="Model.MomentFrequent" Key="@K.MomentFrequent" Unit="kNm"></EurocodeInputNumber> *@
    <EurocodeInputNumber ReadOnly=true Value="Model.Mcr" Key="@K.MomentScheurmoment" StringFormat="0.#" Unit="kNm"></EurocodeInputNumber>
    <EurocodeInputNumber ReadOnly=true Value="Model.ScheurwijdteAsMin" Key="@K.ScheurwijdteAsMin" StringFormat="0" Unit="mm²"></EurocodeInputNumber>
@* <EurocodeInputNumber ReadOnly=true Value="Model.ScheurwijdteMax" Key="@K.ScheurwijdteMax" Unit="mm"></EurocodeInputNumber> *@
    <EurocodeInputNumber ReadOnly=true Value="Model.Wk" Key="@K.ScheurwijdteBerekend" Unit="mm" MaxValue="Model.ScheurwijdteMax"></EurocodeInputNumber>


    <EurocodeInputNumber ReadOnly=true Value="Model.ScheurwijdteGrenswaarde.Wmax" Key="@K.ScheurwijdteMax" Unit="mm"></EurocodeInputNumber>
@* <EurocodeInputNumber ReadOnly=true Value="Model.ScheurwijdteMinimumWapening.AsMin" Key="@K.ScheurwijdteAsMin" Unit="mm²"></EurocodeInputNumber> *@


}


@code {
    [Parameter]
    public ScheurwijdteContext Model { get; set; } 
    
    [Parameter]
    public EventCallback<ScheurwijdteContext> ModelChanged { get; set; }

    protected override void OnInitialized()
    {
        // Subscribe op wijzigingen binnen Wapening
        if (Model.Wapening is INotifyPropertyChanged observable)
        {
            observable.PropertyChanged += WapeningPropertyChanged;
        }
        Model.BerekenEnValideer();
    }

    private void WapeningPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        // Bij elke wijziging binnen Wapening:
        Model.BerekenEnValideer();
        StateHasChanged(); // Als je UI wilt hertekenen
        ModelChanged.InvokeAsync(Model); // Als je twee-weg binding gebruikt
    }

    
    private void OnUpdated()
    {
        StateHasChanged(); // Optioneel: extra hertekening
    }
    
   

}
