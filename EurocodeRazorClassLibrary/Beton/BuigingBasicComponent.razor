@using Eurocode.BetonConstructies
@using K = CommonLibrary.EurocodeKeys;


<p>@Model.Beton.BetonSterkteKlasseGebruiksvriendelijkeNaam</p>

<EurocodeBetonMaterialen @bind-Model=Model.Beton></EurocodeBetonMaterialen>


<EurocodeInputNumber @bind-Value=Model.M Key="@K.MomentRekenwaarde" Unit="kNm"></EurocodeInputNumber>
<EurocodeInputNumber @bind-Value=Model.B Key="@K.ProfielBreedte" Unit="mm"></EurocodeInputNumber>
<EurocodeInputNumber @bind-Value=Model.H Key="@K.ProfielHoogte" Unit="mm"></EurocodeInputNumber>


<EurocodeInputNumber @bind-Value=Model.ZRef Key="ReferentieAfstandVoorNuttigeHoogte" Unit="mm"></EurocodeInputNumber>
<EurocodeInputNumber ReadOnly=true Value=Model.D Key="NuttigeHoogte" Unit="mm"></EurocodeInputNumber>
<EurocodeInputNumber ReadOnly=true Value=Model.Xu Key="Xu" Unit="mm" MaxValue="Model.XuMax"></EurocodeInputNumber>
<EurocodeInputNumber ReadOnly=true Value=Model.XuD Key="XuD" Unit="-" MaxValue="Model.XuDMax"></EurocodeInputNumber>
<EurocodeInputNumber ReadOnly=true Value=Model.Z Key="Z" Unit="mm"></EurocodeInputNumber>

<EurocodeInputNumber ReadOnly=true Value=Model.SigmaS Key="Staalspanning" Unit="MPa"></EurocodeInputNumber>



@* <BetonProfiel @bind-Model="profielDemo"></BetonProfiel> *@


@* <FluentNumberField @bind-Value="Model.B">B [mm]</FluentNumberField> *@
@* <FluentNumberField @bind-Value="Model.H">H [mm]</FluentNumberField> *@
@* <FluentNumberField @bind-Value="Model.ZRef">z-ref [mm]</FluentNumberField> *@
@* <FluentNumberField ReadOnly="true" Value="Model.D">d [mm]</FluentNumberField> *@

<EurocodeInputNumber ReadOnly=true Value=Model.AsMin Key="AsMin" Unit="mm²"></EurocodeInputNumber>
<EurocodeInputNumber ReadOnly=true Value=Model.AsRequired Key="AsBen" Unit="mm²"></EurocodeInputNumber>
<EurocodeInputNumber ReadOnly=true Value=Model.AsApplied Key="AsToe" Unit="mm²"></EurocodeInputNumber>






@* 
<FluentTextField Value="@Model.AsMin1.ToString("0 mm²")">As;min</FluentTextField>
<FluentTextField Value="@Model.AsMin1.ToString("0 mm²")">As;min1</FluentTextField>
<FluentTextField Value="@Model.AsMin2.ToString("0 mm²")">As;min2</FluentTextField>
 *@

@* <FluentTextField Value="@Model.Beton.FactorN.ToString("0.00")">N</FluentTextField>
<FluentTextField Value="@Model.Beton.GetAlpha().ToString("0.000")">Alpha</FluentTextField>
<FluentTextField Value="@Model.Beton.GetBeta().ToString("0.000")">Beta</FluentTextField>
 *@


@* <EurocodeBetonTabel Model="@Model.Beton" /> *@







@if (Model.MinimaleWapeningToegepast)
{
    <p>Minimale wapening toegepast</p>
}


@code {
    [Parameter, EditorRequired]
    public required BendingResults Model{ get; set; }



    [Parameter]
    public EventCallback<Eurocode.BetonConstructies.BendingResults> ModelChanged { get; set; }

    public BetonProfielen.BetonProfiel profielDemo { get; set; } = new();



}
