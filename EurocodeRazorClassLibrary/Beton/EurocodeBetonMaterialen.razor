@using Eurocode.BetonConstructies
@* <BaseEurocodeContextComponent Model="Model"></BaseEurocodeContextComponent> *@ <!-- debug only -->

@if (ShowUserFriendly)
{
    <p>
        <i>betonsterkteklasse</i> : <b> @Model.BetonSterkteKlasseGebruiksvriendelijkeNaam</b> (@Model.SpanningRekDiagram)
        <i>staalkwaliteit</i> : <b> @Model.BetonStaal.BetonStaalKwaliteit</b> (@Model.BetonStaal.SpanningRekDiagram)
    </p>
}
else
{
    <FluentSelectEnum Label="@LabelBetonsterkteklasse"
    TEnum="BetonsterkteklasseEnum"
    ExcludeEnumItems="@_betonSterkteklasseExcludedItems"
    @bind-EnumSelectedValue="@Model.Betonsterkteklasse"
    ReadOnly="@ReadOnly"
    Disabled="@ReadOnly" />

    @if (ToonBetonSpanningRekDiagram)
    {
        <FluentSelectEnum Label="spanning-rek diagram (beton)"
        TEnum="BetonContext.SpanningRekDiagramType"
        @bind-EnumSelectedValue="@Model.SpanningRekDiagram"
        Disabled="@Disabled" />
    }

    @if (ToonBetonstaal)
    {
        <FluentSelectEnum Label="betonstaalkwaliteit"
        TEnum="BetonStaalKwaliteitEnum"
        ExcludeEnumItems="@_betonStaalKwaliteitExcludedItems"
        @bind-EnumSelectedValue="@Model.BetonStaal.BetonStaalKwaliteit"
        Disabled="@Disabled" />
    }

    @if (ToonBetonStaalSpanningRekDiagram)
    {
        <FluentSelectEnum Label="spanning-rek diagram (betonstaal)"
        TEnum="BetonStaalContext.SpanningRekDiagramType"
        @bind-EnumSelectedValue="@Model.BetonStaal.SpanningRekDiagram"
        Disabled="@Disabled" />
    }
}



@code {

    /// <summary>
    /// De betoncontext.
    /// </summary>
    [Parameter, EditorRequired]
    public required BetonContext Model { get; set; } = new();

    /// <summary>
    /// Callback is nodig voor @bind-Model
    /// </summary>
    [Parameter]
    public EventCallback<BetonContext> ModelChanged { get; set; }

    protected override void OnInitialized()
    {
        Model.OnUpdated += StateHasChanged;
    }


    protected override void OnParametersSet()
    {
        // React op modelwijzigingen
        Console.WriteLine($"Model gewijzigd: {Model?.BetonSterkteKlasseGebruiksvriendelijkeNaam}");
        StateHasChanged();
    }

    [Parameter]
    public bool ShowUserFriendly { get; set; } = false;

    [Parameter]
    public bool ReadOnly{ get; set; }

    [Parameter]
    public string LabelBetonsterkteklasse { get; set; } = "betonsterkteklasse";

    /// <summary>
    /// Optie om keuze betonstaal wel/niet te tonen.
    /// Standaard true.
    /// </summary>
    [Parameter]
    public bool ToonBetonstaal { get; set; } = !true;

    /// <summary>
    /// Optie om de keuze voor spanning-rek-diagram van beton wel/niet te tonen.
    /// Standaard true.
    /// </summary>
    [Parameter]
    public bool ToonBetonSpanningRekDiagram { get; set; } = !true;

    /// <summary>
    /// Optie om de keuze voor spanning-rek-diagram van het betonstaal wel/niet te tonen.
    /// Standaard true.
    /// </summary>
    [Parameter]
    public bool ToonBetonStaalSpanningRekDiagram { get; set; } = !true;

    /// <summary>
    /// Optie voor keuze mogelijkheid te blokkeren
    /// Standaard false.  
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; } = false;

    /// <summary>
    /// Optie voor keuzelijst betonsterkteklasse (specifieke opgave)
    /// Standaard is de lijst leeg.
    /// NB. als de lijst leeg is worden alle opties getoond.
    /// </summary>
    [Parameter]
    public BetonsterkteklasseEnum[] BetonSterkteklasseEnumItems { get; set; } = [];

    private BetonsterkteklasseEnum[] _betonSterkteklasseExcludedItems
    {
        get
        {
            if (BetonSterkteklasseEnumItems.Length == 0)
            {
                return [];
            }
            else
            {
                List<BetonsterkteklasseEnum> excludeEnums = [];

                excludeEnums.AddRange(Enum
                .GetValues(typeof(BetonsterkteklasseEnum))
                .Cast<BetonsterkteklasseEnum>()
                .Where(e => !BetonSterkteklasseEnumItems.Contains(e))
                .ToList());


                return excludeEnums.ToArray();
            }
        }
    }


    /// <summary>
    /// Optie voor keuzelijst betonstaal. (specifieke opgave)
    /// Standaard B500A, B500B en B500C.
    /// NB. als de lijst leeg is worden alle opties getoond.
    /// 
    /// </summary>
    [Parameter]
    public BetonStaalKwaliteitEnum[] BetonStaalKwaliteitEnumItems { get; set; } = [BetonStaalKwaliteitEnum.B500A, BetonStaalKwaliteitEnum.B500B, BetonStaalKwaliteitEnum.B500C];
    
    private BetonStaalKwaliteitEnum[] _betonStaalKwaliteitExcludedItems
    {
        get
        {
            if (BetonStaalKwaliteitEnumItems.Length == 0)
            {
                return [];
            }
            else
            {
                List<BetonStaalKwaliteitEnum> excludeEnums = [];
                
                excludeEnums.AddRange(Enum
                .GetValues(typeof(BetonStaalKwaliteitEnum))
                .Cast<BetonStaalKwaliteitEnum>()  
                .Where(e => !BetonStaalKwaliteitEnumItems.Contains(e))
                .ToList());


                return excludeEnums.ToArray();
            }
    }}







}