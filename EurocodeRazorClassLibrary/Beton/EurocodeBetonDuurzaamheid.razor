@using Eurocode.BetonConstructies
@using Eurocode.Grondslagen

<h3>EurocodeBetonDuurzaamheid</h3>


<p>Ontwerplevensduur: @Model.Grondslagen.OntwerpLevensduur.GetOntwerplevensduurTekst()</p>
<p>Betonsterkteklasse: @Model.Beton.BetonSterkteKlasseGebruiksvriendelijkeNaam</p>
<p>Constructieklasse: @Model.Constructieklasse.UserFriendlyName</p>

<FluentCheckbox @bind-Value="Model.IsKwaliteitsBeheersing">Kwaliteitsbeheersing</FluentCheckbox>
<FluentCheckbox @bind-Value="Model.IsPlaatGeometrie">Plaatgeometrie</FluentCheckbox>

<FluentAutocomplete 
    
    TOption="Eurocode.BetonConstructies.MilieuklasseEnum"
    AutoComplete="off"
    Width="300px"
    MaxAutoHeight="200px"
    Label="Milieuklasse(n)"
    Placeholder="zoek"
    OnOptionsSearch="@OnSearchEnum"

    MaximumSelectedOptions="5"
    OptionText="@(item => item.ToString())"
    @bind-SelectedOptions="@Model.Milieuklassen">
    </FluentAutocomplete>



<p>Dekking nominaal: @Model.DekkingNom mm</p>

<FluentNumberField 
Label = "Dekking toegepast"
Min = "10"
Max = "70"
Step = "5"
@bind-Value="Model.DekkingToe">
</FluentNumberField>

@if (Model.DekkingToe < Model.DekkingNom){
    <FluentLabel Typo="Typography.Body" Color="@Color.Warning">Let op! <strong>te weining dekking</strong> toegepast.</FluentLabel>
    <p class="alert">Let op te weinig dekking.</p>
}


<p>Naam: @Model.Naam</p>






@code {
    [Parameter]
    public required BetonDekkingContext Model{ get; set; } 

    [Parameter]
    public EventCallback<Eurocode.BetonConstructies.BetonDekkingContext> ModelChanged { get; set; }

    async Task UpdateModel()
    {
        await ModelChanged.InvokeAsync(Model);
    }

    private MilieuklasseEnum[] _milieuklasseEnumItems = Enum
    .GetValues(typeof(MilieuklasseEnum))
    .Cast<MilieuklasseEnum>()
    .ToArray();


    FluentAutocomplete<Eurocode.BetonConstructies.MilieuklasseEnum> MkList = default!;

    IEnumerable<MilieuklasseEnum> SelectedItems = Array.Empty<MilieuklasseEnum>();


    private void OnSearchEnum(OptionsSearchEventArgs<Eurocode.BetonConstructies.MilieuklasseEnum> e)
    {
        // de keuzelijst bijwerken
        e.Items = _milieuklasseEnumItems.Where(i => i.ToString().Contains(e.Text, StringComparison.OrdinalIgnoreCase)).OrderBy(i => i);
                




    }

    // Wat moeten we laten zien:
    // Milieuklasse 
    // Positie (ONDER/BOVEN)
    // Constructieklasse
    // Referentie-periode
    // Betonsterkte
    
    // Overige zaken van invloed:
    // - kwaliteitsbeheersing
    // - etcetera



}
