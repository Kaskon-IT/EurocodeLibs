@code {
    [Parameter, EditorRequired] public Profielen.Beton.BetonProfiel Model { get; set; } = new();
    [Parameter] public EventCallback<Profielen.Beton.BetonProfiel> ModelChanged { get; set; }
    [Parameter] public ParametrischeProfielVormEnum[] DisabledProfielVormen{ get; set; } = [
        ParametrischeProfielVormEnum.Rond,
        ParametrischeProfielVormEnum.Buis,
        ParametrischeProfielVormEnum.Koker,
        ParametrischeProfielVormEnum.U1,
        ParametrischeProfielVormEnum.U2,
        ParametrischeProfielVormEnum.U3,
        ParametrischeProfielVormEnum.U4,
        ParametrischeProfielVormEnum.L1,
        ParametrischeProfielVormEnum.L2,
        ParametrischeProfielVormEnum.L3,
        ParametrischeProfielVormEnum.L4,
        ParametrischeProfielVormEnum.Z1,
        ParametrischeProfielVormEnum.Z2,
        ParametrischeProfielVormEnum.T1,
        ParametrischeProfielVormEnum.T2,
        ParametrischeProfielVormEnum.T3,
        ParametrischeProfielVormEnum.T4,
        ParametrischeProfielVormEnum.I,
        ParametrischeProfielVormEnum.H,
        ParametrischeProfielVormEnum.EigenProfiel,
    ];



    protected override void OnInitialized()
    {
        // Subscribe to property change notifications
        //Model.PropertyChanged += Model_PropertyChanged;

    }

    private void Model_PropertyChanged(object sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName == nameof(ParametrischProfielContext.Vorm))
        {
            //lastUpdated = $"Name changed to: {model.Name}";

            UpdateControls(Model.Vorm);

            // Trigger re-render
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        // Unsubscribe to avoid memory leaks
        //Model.PropertyChanged -= Model_PropertyChanged;
    }


    private bool showB1 = false;
    private bool showH1 = false;
    private bool showB2 = false;
    private bool showH2 = false;


    public void UpdateControls(ParametrischeProfielVormEnum? vorm)
    {
        if (vorm == null) return;
        switch (vorm)
        {
            default:
            case ParametrischeProfielVormEnum.Rechthoek:
                showB1 = showH1 = showB2 = showH2 = false;
                break;
            case ParametrischeProfielVormEnum.L1:
            case ParametrischeProfielVormEnum.L2:
            case ParametrischeProfielVormEnum.L3:
            case ParametrischeProfielVormEnum.L4:
            case ParametrischeProfielVormEnum.U1:
            case ParametrischeProfielVormEnum.U2:
                showB1 = showH1 = true;
                showB2 = showH2 = false;
                break;
            case ParametrischeProfielVormEnum.T1:
            case ParametrischeProfielVormEnum.T2:
            case ParametrischeProfielVormEnum.T3:
            case ParametrischeProfielVormEnum.T4:
            case ParametrischeProfielVormEnum.I:
            case ParametrischeProfielVormEnum.H:
            case ParametrischeProfielVormEnum.Z1:
            case ParametrischeProfielVormEnum.Z2:
                showB1 = showH1 = showB2 = showH2 = true;
            break;



        }

    }


}
