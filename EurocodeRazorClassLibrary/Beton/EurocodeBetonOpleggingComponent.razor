@using Eurocode.BetonConstructies

@* <p>@Model.ToMarkupString()</p> *@

<FluentGrid Spacing="0">

    <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
        <EurocodeInputNumber Value="@Model.OplegReactieRekenwaarde" Key="OplegReactieRekenwaarde" Unit="kN"
        LabelPosition="@LabelPosition" LabelType="@LabelType" 
        ReadOnly=true  />
    </FluentGridItem>

    <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
        <EurocodeInputNumber @bind-Value="@Model.OplegBreedteNetto" Key="OplegBreedteNetto" Unit="mm"
        LabelPosition="@LabelPosition" LabelType="@LabelType" 
        ReadOnly="IsFieldReadOnly(nameof(Model.OplegBreedteNetto))" />
    </FluentGridItem>

    <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
        <EurocodeInputNumber ReadOnly=true Value="@Model.OplegLengteNetto" Key="OplegLengteNetto" Unit="mm"
        LabelPosition="@LabelPosition" LabelType="@LabelType"
        />
    </FluentGridItem>

    <EurocodeInputNumber ReadOnly=true Value="@Model.AfstandA2" Key="AfstandA2" Unit="mm" LabelPosition="@LabelPosition" LabelType="@LabelType" />
    <EurocodeInputNumber ReadOnly=true Value="@Model.AfstandDeltaA2" Key="AfstandDeltaA2" Unit="mm" LabelPosition="@LabelPosition" LabelType="@LabelType" />
    <EurocodeInputNumber ReadOnly=true Value="@Model.AfstandA3" Key="AfstandA3" Unit="mm" LabelPosition="@LabelPosition" LabelType="@LabelType" />
    
    <EurocodeInputNumber ReadOnly=true Value="@Model.AfstandDeltaA3" Key="AfstandDeltaA3" Unit="mm" LabelPosition="@LabelPosition" LabelType="@LabelType" />
    <EurocodeInputNumber ReadOnly=true Value="@Model.AfstandDeltaElementType" Key="AfstandDeltaElementType" Unit="mm" LabelPosition="@LabelPosition" LabelType="@LabelType" />

    <EurocodeInputNumber ReadOnly=true Value="@Model.OplegLengteNominaal" Key="OplegLengteNominaal" Unit="mm" LabelPosition="@LabelPosition" LabelType="@LabelType" />

   


    <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
        <EurocodeInputNumber Value="@Model.LengteOndersteundeElement" Key="LengteOndersteundeElement" Unit="mm"
        LabelPosition="@LabelPosition" LabelType="@LabelType"
        ReadOnly=true />
    </FluentGridItem>

</FluentGrid>


<FluentGrid Spacing="0">
    <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
        <EurocodeInputNumber @bind-Value="@Model.RekenwaardeOplegmateriaal" Key="RekenwaardeOplegmateriaal" Unit="N/mm²" 
        LabelPosition="@LabelPosition" LabelType="@LabelType"
        ReadOnly=IsFieldReadOnly(nameof(Model.RekenwaardeOplegmateriaal)) />
    </FluentGridItem>

    <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
        <EurocodeInputNumber ReadOnly="true" Value="@Model.OplegSterkteRekenwaarde" Key="OplegSterkteRekenwaarde" Unit="N/mm²" 
        LabelPosition="@LabelPosition" LabelType="@LabelType" />
    </FluentGridItem>

    <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
        <EurocodeInputNumber ReadOnly=true Value="@Model.LaagsteRekenwaardeVanOndersteundeEnHetOndersteunendeElement"
        Key="LaagsteRekenwaardeVanOndersteundeEnHetOndersteunendeElement" Unit="N/mm²" 
        LabelPosition="@LabelPosition" LabelType="@LabelType" />
    </FluentGridItem>

    <EurocodeInputNumber ReadOnly=true Value="@Model.OplegSpanningRekenwaarde"
    Key="OplegSpanningRekenwaarde" Unit="N/mm²"
    LabelPosition="@LabelPosition" LabelType="@LabelType" />

    <EurocodeInputNumber ReadOnly=true Value="@Model.RelatieveOplegspanning"
    Key="RelatieveOplegspanning" Unit="-"
    LabelPosition="@LabelPosition" LabelType="@LabelType" />




</FluentGrid>

<FluentGrid Spacing="0">



    <EurocodeBetonMaterialen @bind-Model="Model.BetonOndersteundeElement"
    ReadOnly=IsFieldReadOnly(nameof(Model.BetonOndersteundeElement))
    LabelBetonsterkteklasse="betonsterkteklasse ondersteunde element" 
    ToonBetonSpanningRekDiagram="false" ToonBetonstaal="false" ToonBetonStaalSpanningRekDiagram="false" />


    <FluentSelectEnum ReadOnly=IsFieldReadOnly(nameof(Model.DetailleringWapening))
    Label="type wapening"
    LabelPosition="@LabelPosition"
    @bind-EnumSelectedValue="Model.DetailleringWapening"
    TEnum="Eurocode.BetonConstructies.OpleggingContext.DetailleringWapeningEnum"/>


    <FluentSelectEnum ReadOnly=IsFieldReadOnly(nameof(Model.OpleggingElementType))
    Label="type element"
    LabelPosition="@LabelPosition"
    @bind-EnumSelectedValue="Model.OpleggingElementType"
    TEnum="Eurocode.BetonConstructies.OpleggingContext.OpleggingElementTypeEnum"/>


    <FluentSelectEnum ReadOnly=IsFieldReadOnly(nameof(Model.OplegType))
    Style="width: 100%;" 
    Label="type oplegging"
    LabelPosition="@LabelPosition"
    @bind-EnumSelectedValue="Model.OplegType"
    TEnum="Eurocode.BetonConstructies.OplegTypeEnum"/>


    <FluentSelectEnum ReadOnly=IsFieldReadOnly(nameof(Model.OplegMateriaal))
    Style="width: 100%;" 
    Label="materiaal ondersteuning"
    LabelPosition="@LabelPosition"
    @bind-EnumSelectedValue="Model.OplegMateriaal"
    TEnum="Eurocode.BetonConstructies.OplegMateriaalEnum"/>


</FluentGrid>


<FluentGrid Spacing="0">
    @* <EurcodeVerticalHeader Tekst="Ondersteuning"></EurcodeVerticalHeader> *@






    @if (
    Model.OplegMateriaal != null &&
    (Model.OplegMateriaal == OplegMateriaalEnum.PREFAB_BETON || Model.OplegMateriaal == OplegMateriaalEnum.IHWG_BETON)
    )
    {
        <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
            <FluentSelectEnum Label="sterkteklasse"
            @bind-EnumSelectedValue="Model.BetonsterkteklasseDragendeElement"
            TEnum="Eurocode.BetonConstructies.BetonsterkteklasseEnum">
            </FluentSelectEnum>
        </FluentGridItem>
    }
    @if (
    Model.OplegMateriaal != null &&
    Model.OplegMateriaal == OplegMateriaalEnum.METSELWERK
    )
    {
        <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
            <EurocodeInputNumber @bind-Value="@Model.OpgaveDruksterkteMetselwerk" Key="OpgaveDruksterkteMetselwerk" Unit="N/mm²" />
        </FluentGridItem>
    }









</FluentGrid>



@code {
    /// <summary>
    /// Het model
    /// </summary>
    [Parameter, EditorRequired]
    public required OpleggingContext Model { get; set; }


    /// <summary>
    /// Callback is nodig voor @bind-Model
    /// </summary>
    [Parameter]
    public EventCallback<OpleggingContext> ModelChanged { get; set; }



    [Parameter]
    public LabelType LabelType { get; set; } = LabelType.SymbolAndDescription;

    [Parameter]
    public LabelPosition LabelPosition { get; set; } = LabelPosition.Left;

    [Parameter]
    public Dictionary<string, bool> ReadOnlyFields { get; set; } = new();


    private bool IsFieldReadOnly(string fieldName) =>
        ReadOnlyFields.TryGetValue($"{fieldName}", out var isReadOnly) && isReadOnly;

    private int xsSizeBAK => LabelPosition == LabelPosition.Left ? 12 : 6;
    private int mdSizeBAK => LabelPosition == LabelPosition.Left ? 12 : 4;
    private int lgSizeBAK => LabelPosition == LabelPosition.Left ? 12 : 3;

    private int xsSize => (LabelPosition, LabelType) switch
    {
        (LabelPosition.Left, LabelType.Symbol) => 6,
        (LabelPosition.Left, LabelType.SymbolAndDescription) => 12,
        (LabelPosition.Top, LabelType.Symbol) => 6,
        (LabelPosition.Top, LabelType.SymbolAndDescription) => 12,
        _ => 12 // Standaardwaarde
    };

    private int mdSize => (LabelPosition, LabelType) switch
    {
        (LabelPosition.Left, LabelType.Symbol) => 4,
        (LabelPosition.Left, LabelType.SymbolAndDescription) => 12,
        (LabelPosition.Top, LabelType.Symbol) => 4,
        (LabelPosition.Top, LabelType.SymbolAndDescription) => 12,
        _ => 12 // Standaardwaarde
    };

    private int lgSize => (LabelPosition, LabelType) switch
    {
        (LabelPosition.Left, LabelType.Symbol) => 3,
        (LabelPosition.Left, LabelType.SymbolAndDescription) => 12,
        (LabelPosition.Top, LabelType.Symbol) => 3,
        (LabelPosition.Top, LabelType.SymbolAndDescription) => 6,
        _ => 12 // Standaardwaarde
    };



    protected override void OnInitialized()
    {
        //Model = new(Beton, Profiel, 100);
        //Model = new();
        //Model.Update();

    }

    protected override void OnParametersSet()
    {
        Console.WriteLine($"Model R={Model?.OplegReactieRekenwaarde.ToString()}");
        //Model.Update(); // niet doen
    }






}
