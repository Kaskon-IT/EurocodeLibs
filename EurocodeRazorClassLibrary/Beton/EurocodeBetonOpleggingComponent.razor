@using Eurocode.BetonConstructies

<FluentGrid Spacing="1">

    <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
        <EurocodeInputNumber @bind-Value="@Model.OplegReactieRekenwaarde" Key="OplegReactieRekenwaarde" Unit="kN" 
        LabelPosition="@LabelPosition" LabelType="@LabelType"/>
    </FluentGridItem>

    <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
        <EurocodeInputNumber @bind-Value="@Model.OplegBreedteNetto" Key="OplegBreedteNetto" Unit="mm" 
        LabelPosition="@LabelPosition" LabelType="@LabelType" />
    </FluentGridItem>

    <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
        <EurocodeInputNumber ReadOnly=true Value="@Model.OplegLengteNetto" Key="OplegLengteNetto" Unit="mm" 
        LabelPosition="@LabelPosition" LabelType="@LabelType" />
    </FluentGridItem>

    <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
        <EurocodeInputNumber @bind-Value="@Model.LengteOndersteundeElement" Key="LengteOndersteundeElement" Unit="mm"
                             LabelPosition="@LabelPosition" LabelType="@LabelType" />
    </FluentGridItem>

</FluentGrid>


<FluentGrid Spacing="1">
    <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
        <EurocodeInputNumber @bind-Value="@Model.RekenwaardeOplegmateriaal" Key="RekenwaardeOplegmateriaal" Unit="N/mm²" 
        LabelPosition="@LabelPosition" LabelType="@LabelType" />
    </FluentGridItem>

    <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
        <EurocodeInputNumber ReadOnly="true" Value="@Model.OplegSterkteRekenwaarde" Key="OplegSterkteRekenwaarde" Unit="N/mm²" 
        LabelPosition="@LabelPosition" LabelType="@LabelType" />
    </FluentGridItem>

    <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
        <EurocodeInputNumber ReadOnly=true Value="@Model.LaagsteRekenwaardeVanOndersteundeEnHetOndersteunendeElement"
        Key="LaagsteRekenwaardeVanOndersteundeEnHetOndersteunendeElement" Unit="N/mm²" 
        LabelPosition="@LabelPosition" LabelType="@LabelType" />
    </FluentGridItem>

</FluentGrid>

<FluentGrid Spacing="0">



    <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
        <EurocodeBetonMaterialen @bind-Model="Model.BetonOndersteundeElement" ToonBetonSpanningRekDiagram="false" ToonBetonstaal="false" ToonBetonStaalSpanningRekDiagram="false" />
    </FluentGridItem>

   

    <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
        <FluentSelectEnum Label="type wapening"
        @bind-EnumSelectedValue="Model.DetailleringWapening"
        TEnum="Eurocode.BetonConstructies.OpleggingContext.DetailleringWapeningEnum">
        </FluentSelectEnum>
    </FluentGridItem>

    <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
        <FluentSelectEnum Label="type element"
        @bind-EnumSelectedValue="Model.OpleggingElementType"
        TEnum="Eurocode.BetonConstructies.OpleggingContext.OpleggingElementTypeEnum">
        </FluentSelectEnum>
    </FluentGridItem>

    <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
        <FluentSelectEnum Style="width: 100%;" Label="type oplegging"
                          @bind-EnumSelectedValue="Model.OplegType"
                          TEnum="Eurocode.BetonConstructies.OplegTypeEnum">
        </FluentSelectEnum>
    </FluentGridItem>

    <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
        <FluentSelectEnum Style="width: 100%;" Label="materiaal ondersteuning"
                          @bind-EnumSelectedValue="Model.OplegMateriaal"
                          TEnum="Eurocode.BetonConstructies.OplegMateriaalEnum">
        </FluentSelectEnum>
    </FluentGridItem>



</FluentGrid>


<FluentGrid Spacing="0">
    @* <EurcodeVerticalHeader Tekst="Ondersteuning"></EurcodeVerticalHeader> *@
   





    @if (
    Model.OplegMateriaal != null &&
    (Model.OplegMateriaal == OplegMateriaalEnum.PREFAB_BETON || Model.OplegMateriaal == OplegMateriaalEnum.IHWG_BETON)
    )
    {
        <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
            <FluentSelectEnum Label="sterkteklasse"
            @bind-EnumSelectedValue="Model.BetonsterkteklasseDragendeElement"
            TEnum="Eurocode.BetonConstructies.BetonsterkteklasseEnum">
            </FluentSelectEnum>
        </FluentGridItem>
    }
    @if (
    Model.OplegMateriaal != null &&
    Model.OplegMateriaal == OplegMateriaalEnum.METSELWERK
    )
    {
        <FluentGridItem xs="@xsSize" md="@mdSize" lg="@lgSize">
            <EurocodeInputNumber @bind-Value="@Model.OpgaveDruksterkteMetselwerk" Key="OpgaveDruksterkteMetselwerk" Unit="N/mm²" />
        </FluentGridItem>
    }









</FluentGrid>



@code {
    /// <summary>
    /// Het model
    /// </summary>
    [Parameter, EditorRequired]
    public required OpleggingContext Model { get; set; }






    /// <summary>
    /// Callback is nodig voor @bind-Model
    /// </summary>
    [Parameter]
    public EventCallback<OpleggingContext> ModelChanged { get; set; }



    [Parameter]
    public LabelType LabelType { get; set; } = LabelType.SymbolAndDescription;

    [Parameter]
    public LabelPosition LabelPosition { get; set; } = LabelPosition.Left;




    private int xsSizeBAK => LabelPosition == LabelPosition.Left ? 12 : 6;
    private int mdSizeBAK => LabelPosition == LabelPosition.Left ? 12 : 4;
    private int lgSizeBAK => LabelPosition == LabelPosition.Left ? 12 : 3;

    private int xsSize => (LabelPosition, LabelType) switch
    {
        (LabelPosition.Left, LabelType.Symbol) => 6,
        (LabelPosition.Left, LabelType.SymbolAndDescription) => 12,
        (LabelPosition.Top, LabelType.Symbol) => 6,
        (LabelPosition.Top, LabelType.SymbolAndDescription) => 12,
        _ => 12 // Standaardwaarde
    };

    private int mdSize => (LabelPosition, LabelType) switch
    {
        (LabelPosition.Left, LabelType.Symbol) => 4,
        (LabelPosition.Left, LabelType.SymbolAndDescription) => 12,
        (LabelPosition.Top, LabelType.Symbol) => 4,
        (LabelPosition.Top, LabelType.SymbolAndDescription) => 12,
        _ => 12 // Standaardwaarde
    };

    private int lgSize => (LabelPosition, LabelType) switch
    {
        (LabelPosition.Left, LabelType.Symbol) => 3,
        (LabelPosition.Left, LabelType.SymbolAndDescription) => 12,
        (LabelPosition.Top, LabelType.Symbol) => 3,
        (LabelPosition.Top, LabelType.SymbolAndDescription) => 6,
        _ => 12 // Standaardwaarde
    };



    protected override void OnInitialized()
    {
        //Model = new(Beton, Profiel, 100);
        Model = new();
        Model.Update();

    }

    
   

