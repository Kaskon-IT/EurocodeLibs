@using Plotly.Blazor
@using Plotly.Blazor.LayoutLib
@using Plotly.Blazor.Traces
@using Plotly.Blazor.Traces.ScatterLib
@using Plotly.Blazor.LayoutLib.ShapeLib

<h3>BetonProfielChart</h3>

<FluentButton OnClick="UpdateChart">Update</FluentButton>
<PlotlyChart @bind-Config="config" @bind-Layout="layout" @bind-Data="data" @ref="chart"/>

@code {
    [Parameter, EditorRequired]
    public ParametrischeProfielen.ParametrischProfielContext Model { get; set; } = new();

    [Parameter]
    public EventCallback<ParametrischeProfielen.ParametrischProfielContext> ModelChanged{ get; set; }


    private List<object> xValues = [];
    private List<object> yValues = [];



    PlotlyChart chart = new();
    Config config = new Config();
    Layout layout = new Layout();
    IList<ITrace> data = new List<ITrace>
    {
        new Scatter
        {
            Name = "ScatterTrace",
            Mode = ModeFlag.Lines | ModeFlag.Markers,
            X = new List<object>{0, 400 ,400, 0},
            Y = new List<object>{0,0,500,500}
        }
    };


    protected override async void OnInitialized()
    {
        if (Model == null) return;

        var startDate = DateTime.Now;

        config = new Config
            {
                //AutoSizable = true,
                Responsive = true,
                Editable = !true,

            };

        layout = new Layout
            {
                //AutoSize = true,
                Title = new Title
                {
                    Text = "Profiel"
                },
                XAxis = new List<XAxis>(){
                new()
                {
                    //AutoRange = Plotly.Blazor.LayoutLib.XAxisLib.AutoRangeEnum.True,
                    Title = new(){Text = "Breedte [mm]"},
                    ShowGrid = false,
                    ShowLine = false,
                    ZeroLine = false,
                    Tick0 = 0,

                }
            },
                YAxis = new List<YAxis>(){
                new()
                {
                    //AutoRange = Plotly.Blazor.LayoutLib.YAxisLib.AutoRangeEnum.True,
                    Title = new(){Text = "Hoogte [mm]"},
                    ScaleAnchor = "x",
                    ScaleRatio = 1,
                    ShowGrid = false,
                    ZeroLine = false,
                    ShowLine = false,
                    Tick0 = 0,

                }
            },

                //PaperBgColor = Theme.PaletteDark.Surface.ToString(),
                //PlotBgColor = Theme.PaletteDark.Surface.ToString(),
                Font = new Font
                {
                    //Color = Theme.PaletteDark.TextPrimary.ToString()
                },
                Shapes = new List<Shape>()
            {
                new()
                {
                    Name = "Profiel",
                    Type = TypeEnum.Rect,
                    X0 = 0,
                    X1 = Model.Breedte,
                    Y0 = 0,
                    Y1 = Model.Hoogte,
                    XRef = "x",
                    YRef = "y",
                    Line = new()
                    {
                        Width = 1
                    },
                    FillColor = "rgba(84,166,143,1)",
                    Opacity = 0.3m
                },

            }
            };

        data = new List<ITrace>
        {
            new Scatter
            {
                Name = "ScatterTrace",
                Mode = ModeFlag.Markers,
                X = new List<object>{0, Model.Breedte },
                Y = new List<object>{0, Model.Hoogte }
            },
        };

        await UpdateChart();
        base.OnInitialized();
       
    }

    private async Task UpdateChart()
    {
        if (Model == null) return;

        var punten = Model.Polygon;

        xValues = punten.Select(prop => (object)prop.X).ToList();
        yValues = punten.Select(prop => (object)prop.Y).ToList();




        data = new List<ITrace>
        {
            new Scatter
            {
                Name = "ScatterTrace",
                Mode = ModeFlag.Lines,
                X = xValues,
                Y = yValues,

            },
            new Scatter{
                Name = "ZwPnt",
                Mode = ModeFlag.Markers,
                Text = "zwpnt",
                X = new List<object>(){(object)Model.Zwaartepunt.X },
                Y = new List<object>(){(object)Model.Zwaartepunt.Y },
                Marker = new Marker(){ Symbol = Plotly.Blazor.Traces.ScatterLib.MarkerLib.SymbolEnum.CircleCrossOpen, Size = 20},
            }
        };

        layout.AutoSize = true;
        layout.Height = 500;

        layout.XAxis = new List<XAxis>()
        {
            new(){
                ZeroLine = false,
                ShowLine = false,
                ShowGrid = false,
                //AutoRange = Plotly.Blazor.LayoutLib.XAxisLib.AutoRangeEnum.Max,
                //Range = new List<object>{0, SampleProject.BendingResults.B},
                RangeMode = Plotly.Blazor.LayoutLib.XAxisLib.RangeModeEnum.Normal,
                Tick0 = 0,
                Ticks = Plotly.Blazor.LayoutLib.XAxisLib.TicksEnum.Outside,
                TickAngle = -90,
                DTick = Model.Breedte,

                TickMode = Plotly.Blazor.LayoutLib.XAxisLib.TickModeEnum.Array,
                TickVals = xValues,
                

            }
        };

        layout.YAxis = new List<YAxis>(){
            new(){
                  Title = new(){Text = "Hoogte [mm]"},
                    ScaleAnchor = "x",
                    ScaleRatio = 1,
                ZeroLine = false,
                ShowLine = false,
                ShowGrid = false,
                RangeMode = Plotly.Blazor.LayoutLib.YAxisLib.RangeModeEnum.Normal,
                Ticks = Plotly.Blazor.LayoutLib.YAxisLib.TicksEnum.Outside,
                DTick = Model.Hoogte,
                Tick0 = 0,

                TickMode = Plotly.Blazor.LayoutLib.YAxisLib.TickModeEnum.Array,
                TickVals = yValues,

            }
        };


        layout.Shapes = new List<Shape>()
        {
            new()
            {
                Name = "Profiel",
                Type = TypeEnum.Rect,
                X0 = 0,
                X1 = Model.Breedte,
                Y0 = 0,
                Y1 = Model.Hoogte,
                XRef = "x",
                YRef = "y",
                Line = new()
                {
                    Width = 2,
                    Color = "rgba(0,0,0,1)",
                },
                //FillColor = "rgba(84,166,143,1)",
                Opacity = 0.5m
            },
          
        };





        try{

            
            await chart.Update(data, layout); // werkt niet... todo uitzoeken
            await chart.NewPlot();
        }
        catch(Exception ex)
        {

        }


      
    }

    

}
