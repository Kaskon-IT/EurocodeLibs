@using Eurocode.BetonConstructies

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Borderless Table Example</title>
    <style>
        /* Base styles for the table */
        table {
            width: 100%; /* Adjust width as needed */
            border-collapse: collapse; /* Removes spacing between table cells */
        }

        td {
            padding: 1px; /* Add some spacing inside cells */
            vertical-align: top; /* Align text at the top of each cell */
        }

        /* Optional styling to add subtle alignment visuals */
        tr:not(:last-child) td {
            padding-bottom: 2px; /* Add spacing between rows */
        }
    </style>
</head>


<h3>Tabel 3.1 (@Model.BetonSterkteKlasseGebruiksvriendelijkeNaam)</h3>

<table>
    <tr>
        <td style="width: 10em;">fck</td>
        <td>@Model.Fck.ToString("#.## MPa")</td>
    </tr>
    <tr>
        <td>fck,cube</td>
        <td>@Model.FckCube.ToString("#.## MPa")</td>
    </tr>
    <tr>
        <td>fcm</td>
        <td>@Model.Fcm.ToString("#.## MPa")</td>
    </tr>
    <tr>
        <td>fctm</td>
        <td>@Model.Fctm.ToString("#.## MPa")</td>
    </tr>
    <tr>
        <td>fctk,5%</td>
        <td>@Model.FctkVijfProcent.ToString("#.## MPa")</td>
    </tr>
    <tr>
        <td>fctk,95%</td>
        <td>@Model.FctkVijfEnNegentigProcent.ToString("#.## MPa")</td>
    </tr>
   
    <tr>
        <td>Ecm</td>
        <td>@Model.Ecm.ToString("#.## GPa")</td>
    </tr>

    <tr>
        <td>εc1</td>
        <td>@((Model.EpsilonC1 * 1000).ToString("F2") + " ‰")</td>
    </tr>
    <tr>
        <td>εcu1</td>
        <td>@((Model.EpsilonCu1 * 1000).ToString("F2") + " ‰")</td>
    </tr>
    <tr>
        <td>εc2</td>
        <td>@((Model.EpsilonC2 * 1000).ToString("F2") + " ‰")</td>
    </tr>
    <tr>
        <td>εcu2</td>
        <td>@((Model.EpsilonCu2 * 1000).ToString("F2") + " ‰")</td>
    </tr>
    <tr>
        <td>n</td>
        <td>@((Model.FactorN).ToString("F2") + "")</td>
    </tr>

    <tr>
        <td>εc3</td>
        <td>@((Model.EpsilonC3 * 1000).ToString("F2") + " ‰")</td>
    </tr>
    <tr>
        <td>εcu3</td>
        <td>@((Model.EpsilonCu3 * 1000).ToString("F2") + " ‰")</td>
    </tr>



</table>










@code {
    /// <summary>
    /// De betoncontext.
    /// </summary>
    [Parameter, EditorRequired]
    public required BetonContext Model { get; set; } = new();

    




}
