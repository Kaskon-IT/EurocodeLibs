@using Eurocode.Belastingen
@using Eurocode.Grondslagen

<h3>Belastinggevallen</h3>





<FluentDataGrid Items="@Model.BelastingGevallen.AsQueryable()"
                TGridItem="BelastingGeval">

    <PropertyColumn Property="@(c => c.Naam)" Title="Geval" Width ="70px"/>
    <PropertyColumn Property="@(c => c.Type)" Title="Type" Width ="140px"/>
    @* <PropertyColumn Property="@(c => c.Type == BelastingGeval.BelastingGevalTypeEnum.Veranderlijk? c.Gebruiksklasse.ToString(): "")" Title="Gebruiksklasse" /> *@


     <TemplateColumn 
        Style="overflow:visible" 
        Title="Gebruiksklasse">
        @if(context.Type == BelastingGeval.BelastingGevalTypeEnum.Veranderlijk){
            <FluentSelectEnum TEnum="GebruiksklasseEnum" @bind-EnumSelectedValue="@context.Gebruiksklasse" />
        }
    </TemplateColumn>


    <PropertyColumn Property="@(item => item.Type == BelastingGeval.BelastingGevalTypeEnum.Veranderlijk? item.MomentaanFactoren.Mom0.ToString("0.0#") : "")" Title="Ψ₀" Width="50px" />
    <PropertyColumn Property="@(item => item.Type == BelastingGeval.BelastingGevalTypeEnum.Veranderlijk? item.MomentaanFactoren.Mom1.ToString("0.0#") : "")" Title="Ψ₁" Width="50px" />
    <PropertyColumn Property="@(item => item.Type == BelastingGeval.BelastingGevalTypeEnum.Veranderlijk? item.MomentaanFactoren.Mom2.ToString("0.0#") : "")" Title="Ψ₂" Width="50px" />

    <PropertyColumn Property="@(item => item.Type == BelastingGeval.BelastingGevalTypeEnum.Veranderlijk? item.OpgelegdeBelastingen.Vlaklast.ToString("0.0 kN/m²") : "")" Title="q;k" Width="95px" />
    <PropertyColumn Property="@(item => item.Type == BelastingGeval.BelastingGevalTypeEnum.Veranderlijk? item.OpgelegdeBelastingen.Puntlast.ToString("0.0 kN"): "")" Title="Q;k" Width="90px"/>


</FluentDataGrid>



@code {


    [Parameter]
    public required Eurocode.Belastingen.BelastingenContext Model { get; set; } 
       

    [Parameter]
    public EventCallback<Eurocode.Belastingen.BelastingenContext> ModelChanged { get; set; }

    async Task UpdateModel()
    {
        await ModelChanged.InvokeAsync(Model);
    }
    

}
