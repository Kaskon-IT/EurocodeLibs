@using Eurocode.Belastingen
@using Eurocode.Grondslagen

<h3>Belastinggevallen</h3>



<FluentDataGrid Items="@Model.BelastingGevallen.Where(item => item.Type == BelastingGeval.BelastingGevalTypeEnum.Permanent).AsQueryable()"
                TGridItem="BelastingGeval">

    <PropertyColumn Property="@(c => c.Naam)" Title="Geval" Width="70px" />
    <PropertyColumn Property="@(c => c.Type)" Title="Type" Width="140px" />

</FluentDataGrid>


<FluentDataGrid Items="@Model.BelastingGevallen.AsQueryable()"
                TGridItem="BelastingGeval">

    <PropertyColumn Property="@(c => c.Naam)" Title="Geval" Width ="70px"/>
    <PropertyColumn Property="@(c => c.Type)" Title="Type" Width ="140px"/>
    <PropertyColumn Property="@(c => c.Gebruiksklasse)" Title="Gebruiksklasse" />

    <PropertyColumn Property="@(item => item.Type == BelastingGeval.BelastingGevalTypeEnum.Veranderlijk? item.MomentaanFactoren.Mom0:item.Omschrijving)" Title="Ψ₀" Width="50px" />
    <PropertyColumn Property="@(item => item.MomentaanFactoren.Mom1)" Title="Ψ₁" Width="50px" />
    <PropertyColumn Property="@(item => item.MomentaanFactoren.Mom2)" Title="Ψ₂" Width="50px" />

    <PropertyColumn Property="@(item => item.OpgelegdeBelastingen.Vlaklast)" Title="qk [kN/m²]" Width="80px" />
    <PropertyColumn Property="@(item => item.OpgelegdeBelastingen.Puntlast)" Title="Qk [kN]" Width="80px"/>


</FluentDataGrid>



@code {


    [Parameter]
    public required Eurocode.Belastingen.BelastingenContext Model { get; set; } 
       

    [Parameter]
    public EventCallback<Eurocode.Belastingen.BelastingenContext> ModelChanged { get; set; }

    async Task UpdateModel()
    {
        await ModelChanged.InvokeAsync(Model);
    }
    

}
