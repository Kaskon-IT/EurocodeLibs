@using Eurocode.Belastingen
@using Eurocode.Grondslagen


<table class="ec-table col-head">
    <colgroup>
        <col style="width: 20%;" />
        <col style="width: 20%;" />
        <col style="width: 60%;" />
    </colgroup>
    <thead>
        <tr>
            <th>naam</th>
            <th>type</th>
            <th>factoren</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.BelastingCombinaties)
        {
            <tr>
                <td>@item.Naam</td>
                <td>@item.Type</td>
                <td>
                    @if (ShowMomentaanFactoren)
                    {
                        @((MarkupString)item.UserFriendlyTextInclusiefMomentaanFactoren)
                    }
                    else
                    {
                        @((MarkupString)item.UserFriendlyText)
                    }
                </td>
            </tr>
        }
    </tbody>
</table>



@code {
    [Parameter]
    public required Eurocode.Belastingen.BelastingenContext Model { get; set; }

    [Parameter]
    public EventCallback<Eurocode.Belastingen.BelastingenContext> ModelChanged { get; set; }

    async Task UpdateModel()
    {
        await ModelChanged.InvokeAsync(Model);
    }

    [Parameter]
    public bool ShowMomentaanFactoren { get; set; }
}
