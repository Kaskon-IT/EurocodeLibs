@using Eurocode.Belastingen
@using Eurocode.Grondslagen



<p>@Model.Grondslagen.ToMarkupString(true)</p>


<FluentDataGrid Items="@Model.BelastingCombinaties.AsQueryable()"
TGridItem="BelastingCombinatie">

    <PropertyColumn Property="@(c => c.Naam)" Title="naam"  />
    <PropertyColumn Property="@(c => c.Type)" Title="type"  />
    <TemplateColumn Title="factoren">
        @if (ShowMomentaanFactoren)
        {
            @((MarkupString)context.UserFriendlyTextInclusiefMomentaanFactoren)
        }
        else
        {
            @((MarkupString)context.UserFriendlyText)
        }


    </TemplateColumn>
    @* @if (ShowMomentaanFactoren)
    {
       

        <PropertyColumn Property="@(c => (MarkupString)c.UserFriendlyTextInclusiefMomentaanFactoren)" title="Factor(en)" />
    }
    else{
        <PropertyColumn Property="@(c => (MarkupString)c.UserFriendlyText)" title="Factor(en)" />
    } *@
    


</FluentDataGrid>





@code {
    [Parameter]
    public required Eurocode.Belastingen.BelastingenContext Model { get; set; }


    [Parameter]
    public EventCallback<Eurocode.Belastingen.BelastingenContext> ModelChanged { get; set; }

    async Task UpdateModel()
    {
        await ModelChanged.InvokeAsync(Model);
    }

    [Parameter]
    public bool ShowMomentaanFactoren{ get; set; }

}
