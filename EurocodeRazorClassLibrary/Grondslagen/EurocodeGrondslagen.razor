@using ExportFactory.Interfaces.Export
@using ExportFactory.Services
@using Eurocode.Grondslagen

<h3>Grondslagen voor de berekening (EC 0)</h3>


<FluentSelectEnum Label="Nationale bijlage" Placeholder="Selecteer..." TEnum="Eurocode.Grondslagen.NationaleBijlageEnum"
ShowDescription="true" @bind-EnumSelectedValue="@Model.NationaleBijlage" />
<p>
    @*    Selectie: @Model.NationaleBijlage.ToString()&nbsp; *@

    @if (Model != null && Model.NationaleBijlage != null)
    {

        <img class="flag" src="Flags/@(Model.NationaleBijlage.ToString().ToLower()).svg" alt="Land vlag" />
    }
</p>


<FluentSelectEnum Label="Gevolgklasse (Consequence Class)" 
Placeholder="Selecteer..." 
TEnum="Eurocode.Grondslagen.GevolgklasseEnum"
ShowDescription="false"
@bind-EnumSelectedValue="@Model.Gevolgklasse" />

<FluentSelectEnum Label="Ontwerplevensduur" 
TEnum="Eurocode.Grondslagen.OntwerpLevensduurEnum" 
@bind-EnumSelectedValue="@Model.OntwerpLevensduur" />


<FluentTextField    Label="Betrouwbaarheidsklasse" 
Value="@Model.Betrouwbaarheidsklasse.ToString()" 
ReadOnly="true" 
Appearance="FluentInputAppearance.Filled" />

<FluentTextField    Label="K,FI" 
Value="@Model.Kfi.ToString("0.0")" 
ReadOnly="true" 
Appearance="FluentInputAppearance.Filled" />

<FluentTextField    Label="ξ (Xi)" 
Value="@Model.Xi.ToString("0.00")" 
ReadOnly="true" 
Appearance="FluentInputAppearance.Filled" />


@* <FluentButton OnClick="() => ExportCsv()">Export CSV</FluentButton> *@
@* <FluentButton OnClick="() => ExportCsvAsync()">Export CSV Async</FluentButton> *@

@* <FluentButton OnClick="() => ExportTable()">Export Table</FluentButton> *@


@* <CopyToClipboard Title="Copy CSV" Text="@csvContent" /> *@

@* <CopyRtfToClipboard rtfContent="@rtfContent"></CopyRtfToClipboard> *@

@* <CopyToClipboard Title="Copy RTF" Text="@rtfContent" /> *@

@* <FluentButton onclick="ExportPdf">Export PDF</FluentButton> *@



@code {
    [Parameter]
    public required GrondslagenContext Model { get; set; }

    [Parameter]
    public EventCallback<GrondslagenContext> ModelChanged { get; set; }

    async Task UpdateModel()
    {
        await ModelChanged.InvokeAsync(Model);
    }

    private string csvContent { get; set; } = "";
    private string? rtfContent { get; set; } = "";


    async Task ExportPdf(){

        // altijd bijwerken
        //await ExportCsv();
        var pdfCreator = new CsvFactory.CsvToRtfService();
        rtfContent = pdfCreator.CreateRtfFromCsvUsingMigradoc(csvContent: csvContent, "output.pdf");

   
    }



    public void ExportCsv(bool excludeHeaders = false){
        if (Model is IExportableCsv csvExporter){
            csvContent = csvExporter.Export(excludeHeaders);
        }
    }

    async Task ExportCsvAsync(bool excludeHeaders = false){
        if (Model is IExportableCsv csvExporter){
            csvContent = await csvExporter.ExportAsync(excludeHeaders);
        }
    }

    public void ExportTable(){
        if (Model is IExportableMigraDoc migraDocExporter){
            var demo = migraDocExporter.ExportTable();
        }
    }

           

}
