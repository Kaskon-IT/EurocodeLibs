

<h3>Grondslagen voor de berekening (EC 0)</h3>




<FluentSelectEnum Label="Nationale bijlage" Placeholder="Selecteer..." TEnum="Eurocode.Grondslagen.NationaleBijlageEnum"
ShowDescription="true" @bind-EnumSelectedValue="@Model.NationaleBijlage" />
<p>
    @*    Selectie: @Model.NationaleBijlage.ToString()&nbsp; *@

    @if (Model != null && Model.NationaleBijlage != null)
    {

        <img class="flag" src="Flags/@(Model.NationaleBijlage.ToString().ToLower()).svg" alt="Land vlag" />
    }
</p>


<FluentSelectEnum Label="Gevolgklasse (Consequence Class)" 
Placeholder="Selecteer..." 
TEnum="Eurocode.Grondslagen.GevolgklasseEnum"
ShowDescription="false"
@bind-EnumSelectedValue="@Model.Gevolgklasse" />

<FluentSelectEnum Label="Ontwerplevensduur" 
TEnum="Eurocode.Grondslagen.OntwerpLevensduurEnum" 
@bind-EnumSelectedValue="@Model.OntwerpLevensduur" />




<FluentTextField    Label="Betrouwbaarheidsklasse" 
Value="@Model.Betrouwbaarheidsklasse.ToString()" 
ReadOnly="true" 
Appearance="FluentInputAppearance.Filled" />

<FluentTextField    Label="K,FI" 
Value="@Model.Kfi.ToString("0.0")" 
ReadOnly="true" 
Appearance="FluentInputAppearance.Filled" />

<FluentTextField    Label="ξ (Xi)" 
Value="@Model.Xi.ToString("0.00")" 
ReadOnly="true" 
Appearance="FluentInputAppearance.Filled" />


<FluentButton OnClick="ExportCsv">Export CSV</FluentButton>

<CopyToClipboard Title="Copy CSV" Text="@csvContent" />

<CopyRtfToClipboard rtfContent="@rtfContent"></CopyRtfToClipboard>

@* <CopyToClipboard Title="Copy RTF" Text="@rtfContent" /> *@

<FluentButton onclick="ExportPdf">Export PDF</FluentButton>




@code {
    [Parameter]
    public required Eurocode.Grondslagen.GrondslagenContext Model { get; set; }

    [Parameter]
    public EventCallback<Eurocode.Grondslagen.GrondslagenContext> ModelChanged { get; set; }

    async Task UpdateModel()
    {
        await ModelChanged.InvokeAsync(Model);
    }


    private List<string> _columnNames = ["Eurocode (Land)", "Gevolgklasse CC", "Ontwerplevensduur [jaren]", "Betrouwbaarheidsklasse RC", "K_FI~", "ξ"];
    private Dictionary<string, string> _row = new();

    private string csvContent { get; set; } = "";
    private string? rtfContent { get; set; } = "";


    private void UpdateDictionary(){
        _row = new Dictionary<string, string>();

        for (int i = 0; i < _columnNames.Count; i++)
        {
            string strValue = "";
            switch (i)
            {
                case 0: strValue = Model.NationaleBijlage?.ToString() ?? ""; break;
                case 1: strValue = Model.Gevolgklasse?.ToString() ?? ""; break;
                case 2: strValue = Model.OntwerpLevensduur?.ToString() ?? ""; break;
                case 3: strValue = Model.Betrouwbaarheidsklasse.ToString(); break;
                case 4: strValue = Model.Kfi.ToString("0.0"); break;
                case 5: strValue = Model.Xi.ToString("0.00"); break;
            }
            _row.Add(key: _columnNames[i], value: strValue);
        }
    }

    async Task ExportPdf(){

        // altijd bijwerken
        //await ExportCsv();
        var pdfCreator = new CsvFactory.CsvToRtfService();
        rtfContent = pdfCreator.CreateRtfFromCsvUsingMigradoc(csvContent: csvContent, "output.pdf");

        // demo
        await ExportCsvWithInterface();



        await ExportRtfWithInterface();



    }


    public CsvFactory.CsvFileCreator GetCsvFileCreator(List<string> columnNames, List<Dictionary<string,string>> rowDatas)
    {
        // use csvCreator
        var csvFileCreator = new CsvFactory.CsvFileCreator();
        // add headers
        csvFileCreator.AddColumns(columnNames);
        // add rows
        csvFileCreator.AddRows(rowDatas);

        return csvFileCreator;

    }

    async Task ExportCsv()
    {
        // update
        UpdateDictionary();

        // get creator
        var csvCreator = GetCsvFileCreator(_columnNames, new() { _row });

        var sb = csvCreator.GetCsvStringBuilder();
        csvContent = sb.ToString();

        // save to file
        csvCreator.SaveToFile("output.csv");
    }


    async Task ExportCsvWithInterface()
    {
        if (Model is CsvFactory.Interfaces.IExportableCsv csvExporter){
            csvContent = csvExporter.Export();
        }

        //csvContent = Model.CreateCsv();

    }

    async Task ExportRtfWithInterface()
    {
        if (Model is CsvFactory.Interfaces.IExportableRtf rtfExporter){
            rtfContent = rtfExporter.Export();
        }

        //rtfContent = Model.Export();
    }
    async Task ExportPdfWithInterface()
    {
        // test functie voor bijvoegen in een document
        // omdat we geen document hebben, maken we een nieuwe
        MigraDoc.DocumentObjectModel.Section demoSection = new();
        Model.AddToSection(demoSection);
    }

       

}
