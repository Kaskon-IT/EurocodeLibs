<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

		<!-- NuGet-package instellingen -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>Kaskon.ExportFactory</PackageId>
		<Version>1.0.0</Version>
		<Authors>Bart van der Linden</Authors>
		<Company>Kaskon</Company>
		<Description>Library voor pdf, csv, word, html, svg exports.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/YourRepo</RepositoryUrl>
		<PackageProjectUrl>https://www.yourprojectsite.com</PackageProjectUrl>

		<!-- Lokale map voor .nupkg -->
		<PackageOutputPath>T:\04 Standaarden\NuGetPackages</PackageOutputPath>
		<Copyright>Copyright © 2025 Kaskon</Copyright>
		<PackageTags>Kaskon;Blazor;FluentUI;Eurocode;Beton;Constructies;Export;Pdf;Migradoc;Rtf;Word;Svg;Html</PackageTags>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	  
	  
	  
	  
	  
    </PropertyGroup>

	
	
    <ItemGroup>
        <PackageReference Include="MigraDoc.DocumentObjectModel.Core" Version="1.0.0" />
        <PackageReference Include="MigraDoc.Rendering.Core" Version="1.0.0" />
        <PackageReference Include="MigraDoc.RtfRendering.Core" Version="1.0.0" />
        <PackageReference Include="SkiaSharp.Extended" Version="2.0.0" />
        <PackageReference Include="Svg.Skia" Version="2.0.0.4" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CommonLibrary\CommonLibrary.csproj" />
    </ItemGroup>

</Project>
